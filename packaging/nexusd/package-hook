#!/bin/sh
# What Nexus Open's package scripts do, in one place, so pacman, dpkg and
# rpm all do the same. Installed to /usr/lib/nexus-open/package-hook; the
# scripts run it as root:
#
#   package-hook install   after a first install
#   package-hook upgrade   after an upgrade, including from the old Go app
#                          (also packaged as nexus-open)
#   package-hook remove    before the package's files are removed
#
# It never fails the transaction. In a container or a chroot there is no
# udev daemon and nobody is logged in, and those steps do nothing.

unit=nexusd.service

# Users with a service manager running now (logged in, or lingering),
# leaving out system users such as the login screen's.
users() {
    command -v loginctl >/dev/null 2>&1 || return 0
    uid_min=$(awk '$1 == "UID_MIN" { print $2 }' /etc/login.defs 2>/dev/null)
    loginctl list-users --no-legend 2>/dev/null |
        awk -v min="${uid_min:-1000}" '$1 + 0 >= min + 0 { print $2 }'
}

# systemctl --user, in each of those users' own service managers.
each_user() {
    for user in $(users); do
        systemctl --user -M "$user@.host" "$@" >/dev/null 2>&1 || true
    done
}

# Load the new udev rule and apply it to a strip that is plugged in now,
# so the user at the seat gets access without unplugging it.
apply_udev_rule() {
    command -v udevadm >/dev/null 2>&1 || return 0
    udevadm control --reload-rules 2>/dev/null || return 0
    udevadm trigger --action=change --subsystem-match=hidraw 2>/dev/null || true
    udevadm settle --timeout=10 2>/dev/null || true
}

# The old Go app takes the strip from its HID driver and never gives it
# back, so once it stops the strip stays dark until it is replugged. Root
# can give it back: bind each HID interface of the strip that has no
# driver. One the old app still holds stays as it is (the bind fails).
rebind_strip() {
    [ -w /sys/bus/usb/drivers/usbhid/bind ] || return 0
    for intf in /sys/bus/usb/devices/*:*; do
        [ -e "$intf" ] || continue
        [ -e "$intf/driver" ] && continue
        dev=${intf%:*}
        [ "$(cat "$dev/idVendor" 2>/dev/null)" = 1b1c ] || continue
        [ "$(cat "$dev/idProduct" 2>/dev/null)" = 1b8e ] || continue
        [ "$(cat "$intf/bInterfaceClass" 2>/dev/null)" = 03 ] || continue
        echo "${intf##*/}" >/sys/bus/usb/drivers/usbhid/bind 2>/dev/null || true
    done
}

# Start the service at login for every user. 80-nexus-open.preset says
# enable; an administrator's own preset or a mask wins.
enable_for_everyone() {
    systemctl --global preset "$unit" >/dev/null 2>&1 || true
}

case "${1:-}" in
install | upgrade)
    apply_udev_rule
    enable_for_everyone
    # The old Go app's service: stop it so it lets go of the strip.
    # nexusd.service conflicts with it too, but stopping it first lets the
    # strip be handed back before nexusd looks for it.
    each_user stop nexus-open.service
    rebind_strip
    # Users who are logged in now get the strip at once, not at their
    # next login. On an upgrade this also restarts the new version.
    each_user daemon-reload
    each_user restart "$unit"
    ;;
remove)
    each_user stop "$unit"
    systemctl --global disable "$unit" >/dev/null 2>&1 || true
    ;;
*)
    echo "usage: $0 install|upgrade|remove" >&2
    exit 2
    ;;
esac
exit 0
