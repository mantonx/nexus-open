// The settings of what is selected: a widget, the page or a takeover, as
// one left-aligned grid (labels in one column, controls in the next, help
// under the control), the same everywhere. Fields come from Rust
// (inspector.rs, takeovers.rs), so a new setting is added there only.

import { ListView, ScrollView } from "std-widgets.slint";
import { Theme, Icon, Glyph } from "theme.slint";
import { Button, IconButton, TextField, Select, Segmented, Chip, Hint, Label, FocusRing } from "controls.slint";

/// One setting, as the form shows it.
export struct Field {
    key: string,
    label: string,
    /// "text", "number", "choice", "segmented", "note", "signal",
    /// "triggers", or "disclosure" (a heading that opens and closes the
    /// fields after it: value "open" or "closed", help what is set).
    kind: string,
    value: string,
    /// For a choice: the options, and which one is `value` (-1 if none).
    choices: [string],
    index: int,
    help: string,
    /// For a signal: its human name, icon and live value.
    shown: string,
    icon: string,
    reading: string,
}

/// A signal in the picker.
export struct PickRow {
    id: string,
    name: string,
    icon: string,
    value: string,
    chosen: bool,
}

/// A signal that sets off a takeover, as a chip.
export struct Trigger {
    id: string,
    name: string,
    icon: string,
}

/// Width of the label column.
export global Grid {
    out property <length> label: 148px;
    out property <length> control-max: 480px;
}

/// The searchable list of signals, opened from a signal field or "Add a
/// reading", or the grid of the strip's icons. Human names only in the
/// rows; the raw name a layout file uses is a small line at the foot, for
/// the row under the pointer.
export component Picker inherits Rectangle {
    in property <[PickRow]> rows;
    in property <string> title;
    /// Lists the strip's icons, as a grid, instead of readings.
    in property <bool> icons;
    callback filter(string);
    callback pick(string);
    width: 0px;
    height: 0px;

    property <int> hover: -1;
    // The icon grid: tiles and columns.
    property <length> tile: 46px;
    property <length> gap: 6px;
    property <int> cols: 7;

    public function show() {
        root.hover = -1;
        popup.show();
    }

    popup := PopupWindow {
    close-policy: PopupClosePolicy.close-on-click-outside;
    width: root.icons ? root.cols * (root.tile + root.gap) - root.gap + 16px + 14px : 380px;

    Rectangle {
        background: Theme.surface;
        border-radius: Theme.r-surface;
        border-width: 1px;
        border-color: Theme.line-strong;
        drop-shadow-blur: 20px;
        drop-shadow-color: #00000060;
        VerticalLayout {
            padding: 8px;
            spacing: 6px;
            search := TextField {
                placeholder: root.icons ? @tr("Search icons") : @tr("Search readings");
                leading-icon: Glyph.search;
                label: root.title;
                init => {
                    self.focus-input();
                }
                edited(text) => {
                    root.hover = -1;
                    root.filter(text);
                }
                accepted => {
                    if root.rows.length > 0 {
                        root.pick(root.rows[0].id);
                        popup.close();
                    }
                }
                key-pressed(event) => {
                    if event.text == Key.Escape {
                        popup.close();
                        return accept;
                    }
                    reject
                }
            }
            if !root.icons: ListView {
                height: min(300px, max(44px, root.rows.length * 44px));
                for r[ri] in root.rows: Rectangle {
                    height: 44px;
                    border-radius: Theme.r-control - 2px;
                    background: pick-touch.has-hover ? Theme.surface-2 : transparent;
                    accessible-role: button;
                    accessible-label: r.name + ", " + r.value;
                    accessible-description: r.id;
                    accessible-action-default => {
                        root.pick(r.id);
                        popup.close();
                    }
                    HorizontalLayout {
                        padding-left: 8px;
                        // Clear of the list's scroll bar.
                        padding-right: 18px;
                        spacing: 10px;
                        Rectangle {
                            width: 30px;
                            Rectangle {
                                width: 30px;
                                height: 30px;
                                border-radius: 8px;
                                background: Theme.surface-2;
                                Icon {
                                    glyph: r.icon;
                                    fill: true;
                                    font-size: 17px;
                                }
                            }
                        }
                        Text {
                            text: r.name;
                            font-family: Theme.font;
                            font-size: Theme.size-body;
                            font-weight: r.chosen ? 600 : 500;
                            color: Theme.text;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        Text {
                            text: r.value;
                            font-family: Theme.font;
                            font-size: Theme.size-label;
                            color: Theme.text-2;
                            vertical-alignment: center;
                            max-width: 120px;
                            overflow: elide;
                        }
                        Rectangle {
                            width: 16px;
                            if r.chosen: Icon {
                                glyph: Glyph.check;
                                color: Theme.act-line;
                            }
                        }
                    }
                    pick-touch := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        changed has-hover => {
                            if self.has-hover {
                                root.hover = ri;
                            }
                        }
                        clicked => {
                            root.pick(r.id);
                            popup.close();
                        }
                    }
                }
            }
            if root.icons: ScrollView {
                height: min(296px, max(root.tile, ceil(root.rows.length / root.cols) * (root.tile + root.gap) - root.gap));
                content-height: ceil(root.rows.length / root.cols) * (root.tile + root.gap) - root.gap;
                for r[ri] in root.rows: Rectangle {
                    x: mod(ri, root.cols) * (root.tile + root.gap);
                    y: floor(ri / root.cols) * (root.tile + root.gap);
                    width: root.tile;
                    height: root.tile;
                    border-radius: Theme.r-control;
                    background: r.chosen ? Theme.act-wash : tile-touch.has-hover ? Theme.surface-2 : transparent;
                    border-width: r.chosen ? 2px : 1px;
                    border-color: r.chosen ? Theme.act-line : tile-touch.has-hover ? Theme.line-strong : transparent;
                    accessible-role: button;
                    accessible-label: r.name;
                    accessible-description: r.id;
                    accessible-item-selectable: true;
                    accessible-item-selected: r.chosen;
                    accessible-action-default => {
                        root.pick(r.id);
                        popup.close();
                    }
                    Icon {
                        glyph: r.icon;
                        fill: true;
                        font-size: 22px;
                        color: r.chosen ? Theme.text : Theme.text-2;
                    }
                    tile-touch := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        changed has-hover => {
                            if self.has-hover {
                                root.hover = ri;
                            }
                        }
                        clicked => {
                            root.pick(r.id);
                            popup.close();
                        }
                    }
                }
            }
            if root.rows.length == 0: Hint {
                text: root.icons ? @tr("No icon by that name.") : @tr("Nothing matches. A reading appears here once a source publishes it.");
                horizontal-alignment: center;
            }
            // The row under the pointer, named; its raw name, small, for a
            // layout file or a script.
            if root.rows.length > 0: Rectangle {
                height: 1px;
                background: Theme.line;
            }
            if root.rows.length > 0: HorizontalLayout {
                height: 24px;
                padding-left: 4px;
                padding-right: 4px;
                spacing: 8px;
                property <int> shown: root.hover >= 0 && root.hover < root.rows.length ? root.hover : -1;
                Text {
                    text: parent.shown >= 0 ? root.rows[parent.shown].name
                        : root.icons ? @tr("Point at an icon to see its name") : @tr("Point at a reading for its name in a layout file");
                    font-family: Theme.font;
                    font-size: Theme.size-label;
                    font-weight: parent.shown >= 0 ? 500 : 400;
                    color: parent.shown >= 0 ? Theme.text-2 : Theme.text-3;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Text {
                    text: parent.shown >= 0 ? root.rows[parent.shown].id : "";
                    font-family: Theme.mono;
                    font-size: 11px;
                    color: Theme.text-3;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
            }
        }
    }
    }
}

/// One setting: its label, the control for its kind, help under it.
export component FieldRow inherits HorizontalLayout {
    in property <Field> field;
    in property <bool> enabled: true;
    in property <[PickRow]> picks;
    in property <[Trigger]> triggers;
    callback changed(string, string);
    callback chose(string, int);
    callback open-picker(string);
    callback picker-filter(string);
    callback picked(string, string);
    callback remove-trigger(string);
    /// The news widget's "Edit feeds…".
    callback edit-feeds();
    callback edit-town();
    /// An example of the widget, for its "show" field: the picture (as
    /// many strip pixels wide as `example-width`, drawn at `unit` each)
    /// and what it is. No note, no example.
    in property <image> example;
    in property <int> example-width;
    in property <string> example-note;
    in property <length> unit: 1px;

    spacing: 16px;

    // "Limits and scale": a heading across the form that opens and closes
    // the fields under it, saying what is set while closed.
    if root.field.kind == "disclosure": disclosure := Rectangle {
        property <bool> open: root.field.value == "open";
        height: 36px;
        horizontal-stretch: 1;
        border-radius: Theme.r-control;
        background: dis-touch.has-hover && root.enabled ? Theme.surface-2 : transparent;
        accessible-role: button;
        accessible-label: root.field.label;
        accessible-description: root.field.help;
        accessible-expandable: true;
        accessible-expanded: self.open;
        accessible-action-default => {
            root.chose(root.field.key, 0);
        }
        HorizontalLayout {
            padding-left: 4px;
            spacing: 8px;
            Icon {
                glyph: disclosure.open ? Glyph.caret-down : Glyph.caret-right;
                font-size: 14px;
                color: root.enabled ? Theme.text-2 : Theme.text-off;
            }
            Text {
                text: root.field.label;
                font-family: Theme.font;
                font-size: Theme.size-body;
                font-weight: 600;
                color: root.enabled ? Theme.text-2 : Theme.text-off;
                vertical-alignment: center;
            }
            Text {
                text: root.field.help;
                font-family: Theme.font;
                font-size: Theme.size-label;
                color: root.enabled ? Theme.text-3 : Theme.text-off;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
        }
        dis-touch := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => {
                dis-focus.focus();
                root.chose(root.field.key, 0);
            }
        }
        dis-focus := FocusScope {
            property <bool> by-keys;
            focus-gained(reason) => {
                self.by-keys = reason == FocusReason.tab-navigation;
            }
            focus-on-click: false;
            key-pressed(event) => {
                if event.text == " " || event.text == Key.Return {
                    root.chose(root.field.key, 0);
                    return accept;
                }
                reject
            }
        }
        FocusRing {
            width: parent.width + 8px;
            height: parent.height + 8px;
            radius: Theme.r-control;
            shown: dis-focus.has-focus && dis-focus.by-keys;
        }
    }

    if root.field.kind != "disclosure": Text {
        text: root.field.label;
        width: Grid.label;
        y: 9px;
        vertical-alignment: top;
        font-family: Theme.font;
        font-size: Theme.size-body;
        font-weight: 500;
        color: root.enabled ? Theme.text-2 : Theme.text-off;
        wrap: word-wrap;
        accessible-role: none;
    }

    if root.field.kind != "disclosure": VerticalLayout {
        spacing: 4px;
        horizontal-stretch: 1;
        max-width: Grid.control-max;

        if root.field.kind == "text" || root.field.kind == "number": TextField {
            text: root.field.value;
            committed-value: root.field.value;
            enabled: root.enabled;
            label: root.field.label;
            input-type: root.field.kind == "number" ? InputType.decimal : InputType.text;
            accepted(text) => {
                root.changed(root.field.key, text);
            }
            committed(text) => {
                root.changed(root.field.key, text);
            }
        }
        // A whole number in bounds: typed, stepped with the arrow keys (by
        // 10 with Shift) or with the buttons, its range beside it.
        if root.field.kind == "stepper": HorizontalLayout {
            spacing: 6px;
            alignment: start;
            property <int> lo: root.field.choices[0].to-float();
            property <int> hi: root.field.choices[1].to-float();
            property <int> now: number.text.to-float();
            function step(by: int) {
                let v = max(self.lo, min(self.hi, (number.text.is-float() ? self.now : root.field.value.to-float()) + by));
                number.text = v;
                root.changed(root.field.key, v);
            }
            IconButton {
                icon: Glyph.minus;
                label: @tr("{} narrower by 1", root.field.label);
                enabled: root.enabled && parent.now > parent.lo;
                clicked => {
                    parent.step(-1);
                }
            }
            number := TextField {
                width: 96px;
                text: root.field.value;
                committed-value: root.field.value;
                enabled: root.enabled;
                label: @tr("{}, {} to {}", root.field.label, parent.lo, parent.hi);
                input-type: InputType.number;
                accepted(text) => {
                    root.changed(root.field.key, text);
                }
                committed(text) => {
                    root.changed(root.field.key, text);
                }
                key-pressed(event) => {
                    if event.text == Key.UpArrow || event.text == Key.DownArrow {
                        parent.step((event.text == Key.UpArrow ? 1 : -1) * (event.modifiers.shift ? 10 : 1));
                        return accept;
                    }
                    reject
                }
            }
            IconButton {
                icon: Glyph.plus;
                label: @tr("{} wider by 1", root.field.label);
                enabled: root.enabled && parent.now < parent.hi;
                clicked => {
                    parent.step(1);
                }
            }
            Text {
                text: @tr("px, {} to {}", parent.lo, parent.hi);
                font-family: Theme.font;
                font-size: Theme.size-label;
                color: root.enabled ? Theme.text-3 : Theme.text-off;
                vertical-alignment: center;
                accessible-role: none;
            }
        }
        // The news feeds are Settings' (every news widget shares them):
        // how many, and the way there.
        if root.field.kind == "feeds": HorizontalLayout {
            spacing: 10px;
            alignment: start;
            Rectangle {
                width: 28px;
                Rectangle {
                    width: 28px;
                    height: 28px;
                    border-radius: 7px;
                    background: Theme.surface-2;
                    Icon {
                        glyph: Glyph.newspaper;
                        fill: true;
                    }
                }
            }
            Text {
                text: root.field.value == "No feeds yet" ? @tr("No feeds yet — add one") : root.field.shown;
                font-family: Theme.font;
                font-size: Theme.size-body;
                font-weight: 500;
                color: Theme.text;
                vertical-alignment: center;
            }
            Button {
                tier: root.field.value == "No feeds yet" ? "primary" : "default";
                enabled: root.enabled;
                icon: Glyph.feed;
                text: @tr("Edit feeds…");
                label: @tr("Edit the news feeds, in Settings");
                clicked => {
                    root.edit-feeds();
                }
            }
        }
        // No town for the weather yet: the reason, and the way to it.
        if root.field.kind == "town": HorizontalLayout {
            spacing: 10px;
            alignment: start;
            Text {
                text: @tr("No town set yet");
                font-family: Theme.font;
                font-size: Theme.size-body;
                font-weight: 500;
                color: root.enabled ? Theme.text : Theme.text-off;
                vertical-alignment: center;
            }
            Button {
                enabled: root.enabled;
                icon: Glyph.map-pin;
                text: @tr("Set your town…");
                label: @tr("Set the town for the weather, in Settings");
                clicked => {
                    root.edit-town();
                }
            }
        }
        if root.field.kind == "choice": Select {
            options: root.field.choices;
            current: root.field.index;
            enabled: root.enabled;
            label: root.field.label;
            chose(i) => {
                root.chose(root.field.key, i);
            }
        }
        if root.field.kind == "segmented": HorizontalLayout {
            alignment: start;
            Segmented {
                current: root.field.index;
                enabled: root.enabled;
                label: root.field.label;
                options: root.field.choices;
                chose(i) => {
                    root.chose(root.field.key, i);
                }
            }
        }
        // What the choice looks like, while the strip has nothing real
        // to show for it: in the strip's bezel, at the strip's scale.
        if root.field.key == "show" && root.example-note != "": VerticalLayout {
            spacing: 4px;
            padding-top: 4px;
            HorizontalLayout {
                alignment: start;
                Rectangle {
                    width: root.example-width * root.unit + 8px;
                    height: 48 * root.unit + 8px;
                    border-radius: 6px;
                    background: Theme.bezel;
                    Image {
                        source: root.example;
                        width: root.example-width * root.unit;
                        height: 48 * root.unit;
                        image-rendering: pixelated;
                        accessible-role: image;
                        accessible-label: root.example-note;
                    }
                }
            }
            Text {
                text: root.example-note;
                font-family: Theme.font;
                font-size: Theme.size-small;
                font-weight: 500;
                color: Theme.text-2;
                wrap: word-wrap;
            }
        }
        if root.field.kind == "signal" || root.field.kind == "icon": signal-button := Rectangle {
            height: 44px;
            border-radius: Theme.r-control;
            background: !root.enabled ? transparent : sig-touch.has-hover ? Theme.raised.brighter(0.06) : Theme.raised;
            border-width: 1px;
            border-color: root.enabled ? Theme.field-line : Theme.line;
            FocusRing {
                width: parent.width + 8px;
                height: parent.height + 8px;
                radius: Theme.r-control;
                shown: sig-focus.has-focus && sig-focus.by-keys;
            }
            accessible-role: combobox;
            accessible-label: root.field.label;
            accessible-value: (root.field.value == "" && root.field.kind == "icon" ? @tr("The widget's own") : root.field.shown) + (root.field.reading != "" ? ", " + root.field.reading : "");
            accessible-description: root.field.value;
            accessible-action-default => {
                root.open-picker(root.field.key);
                picker.show();
            }
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 10px;
                spacing: 10px;
                Rectangle {
                    width: 28px;
                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 7px;
                        background: Theme.surface-2;
                        Icon {
                            glyph: root.field.icon;
                            fill: true;
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Text {
                        text: root.field.value == "" ? (root.field.kind == "icon" ? @tr("The widget's own") : @tr("Choose a reading")) : root.field.shown;
                        font-family: Theme.font;
                        font-size: Theme.size-body;
                        font-weight: 500;
                        color: !root.enabled ? Theme.text-off : root.field.value == "" && root.field.kind != "icon" ? Theme.text-3 : Theme.text;
                        overflow: elide;
                    }
                }
                Text {
                    text: root.field.reading;
                    font-family: Theme.font;
                    font-size: Theme.size-label;
                    color: root.enabled ? Theme.text-2 : Theme.text-off;
                    vertical-alignment: center;
                }
                Icon {
                    glyph: Glyph.caret-down;
                    font-size: 14px;
                }
            }
            sig-touch := TouchArea {
                enabled: root.enabled;
                mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
                clicked => {
                    sig-focus.focus();
                    root.open-picker(root.field.key);
                    picker.show();
                }
            }
            sig-focus := FocusScope {
                // Its ring is for focus reached by the keyboard; a click
                // focuses it too, and shows the press instead.
                property <bool> by-keys;
                focus-gained(reason) => {
                    self.by-keys = reason == FocusReason.tab-navigation;
                }
                // Its TouchArea focuses it; taking the press here would
                // swallow the first click.
                focus-on-click: false;
                enabled: root.enabled;
                key-pressed(event) => {
                    if event.text == " " || event.text == Key.Return || event.text == Key.DownArrow {
                        root.open-picker(root.field.key);
                        picker.show();
                        return accept;
                    }
                    reject
                }
            }
            picker := Picker {
                x: 0;
                y: parent.height + 4px;
                rows: root.picks;
                icons: root.field.kind == "icon";
                title: root.field.kind == "icon" ? @tr("Choose an icon") : @tr("Search readings for {}", root.field.label);
                filter(text) => {
                    root.picker-filter(text);
                }
                pick(id) => {
                    root.picked(root.field.key, id);
                }
            }
        }
        if root.field.kind == "triggers": VerticalLayout {
            spacing: 8px;
            chips := HorizontalLayout {
                spacing: 6px;
                alignment: start;
                for t in root.triggers: Chip {
                    text: t.name;
                    icon: t.icon;
                    enabled: root.enabled;
                    remove => {
                        root.remove-trigger(t.id);
                    }
                }
                add-trigger := Button {
                    text: root.triggers.length == 0 ? @tr("Choose a reading") : @tr("Add");
                    icon: Glyph.plus;
                    tier: root.triggers.length == 0 ? "primary" : "quiet";
                    compact: true;
                    enabled: root.enabled;
                    label: @tr("Add a reading whose change shows this takeover");
                    clicked => {
                        root.open-picker(root.field.key);
                        trigger-picker.show();
                    }
                }
            }
            // Zero-sized, just under the chips: the list opens there.
            trigger-picker := Picker {
                rows: root.picks;
                title: @tr("Search readings whose change shows it");
                filter(text) => {
                    root.picker-filter(text);
                }
                pick(id) => {
                    root.picked(root.field.key, id);
                }
            }
        }
        if root.field.kind == "note": Rectangle {
            height: 64px;
            border-radius: Theme.r-control;
            background: !root.enabled ? transparent : Theme.dark ? Theme.ground : Theme.surface;
            border-width: 1px;
            border-color: root.enabled ? Theme.field-line : Theme.line;
            clip: true;
            note := TextInput {
                x: 10px;
                y: 8px;
                width: parent.width - 20px;
                height: parent.height - 16px;
                text: root.field.value;
                wrap: word-wrap;
                single-line: false;
                font-family: Theme.font;
                font-size: Theme.size-body;
                color: root.enabled ? Theme.text : Theme.text-off;
                enabled: root.enabled;
                accessible-label: root.field.label;
                changed has-focus => {
                    if !self.has-focus && self.text != root.field.value {
                        root.changed(root.field.key, self.text);
                    }
                }
            }
        }
        if root.field.help != "": Hint {
            text: root.field.help;
        }
    }
}
