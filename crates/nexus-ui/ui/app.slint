// The settings window. For now it is the shell: the live strip preview,
// streamed from the daemon, and page controls. Enough to check rendering,
// keyboard use and screen reader access on each desktop.

import { Button, VerticalBox, HorizontalBox, Palette } from "std-widgets.slint";

export component AppWindow inherits Window {
    title: "Nexus Open";
    icon: @image-url("../assets/icon.png");
    min-width: 720px;
    min-height: 320px;
    preferred-width: 1340px;
    preferred-height: 420px;
    background: Palette.background;

    /// The frame on the strip, 640×48, exactly as the daemon sent it.
    in property <image> frame;
    /// False while the daemon cannot be reached.
    in property <bool> connected;
    /// The page on the strip, and its position ("2 of 4").
    in property <string> page-name;
    in property <string> page-position;
    callback page(string);

    VerticalBox {
        HorizontalBox {
            padding: 0;
            Text {
                text: "Strip preview";
                font-size: 18px;
                font-weight: 600;
                vertical-alignment: center;
            }
            Text {
                text: root.connected && root.page-name != "" ? root.page-name + "  ·  page " + root.page-position : "";
                color: Palette.foreground.transparentize(0.35);
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
        }

        if !root.connected: Rectangle {
            background: #e0a00030;
            border-radius: 6px;
            height: banner.preferred-height + 16px;
            banner := Text {
                x: 12px;
                width: parent.width - 24px;
                text: "Not connected to nexusd. Start it with `nexusd run`; this window reconnects by itself.";
                wrap: word-wrap;
                accessible-role: text;
            }
        }

        preview-area := Rectangle {
            vertical-stretch: 1;
            min-height: 48phx * 2;

            // Largest whole-number scale that fits, counted in physical
            // pixels (phx), not logical ones (px). With fractional desktop
            // scaling a logical-pixel scale would land between device
            // pixels and blur the strip's hinted text.
            property <int> scale: max(1, min(
                floor(self.width / 640phx),
                floor(self.height / 48phx)));

            Image {
                source: root.frame;
                image-rendering: pixelated;
                width: 640phx * preview-area.scale;
                height: 48phx * preview-area.scale;
                // Rounded to whole physical pixels for the same reason.
                x: round((parent.width - self.width) / 2 / 1phx) * 1phx;
                y: round((parent.height - self.height) / 2 / 1phx) * 1phx;
                opacity: root.connected ? 1 : 0.4;
                accessible-role: image;
                accessible-label: "Strip preview, showing page " + root.page-name;
            }
        }

        HorizontalBox {
            alignment: start;
            padding: 0;

            Button {
                text: "Previous page";
                enabled: root.connected;
                clicked => {
                    root.page("prev");
                }
            }

            Button {
                text: "Next page";
                enabled: root.connected;
                clicked => {
                    root.page("next");
                }
            }
        }
    }
}
