// The settings window. The preview is the editor: the live strip, streamed
// from the daemon, with the page's widgets outlined over it. Click one to
// select it, drag it to move it, drag an edge to resize. Every change is an
// edit sent to the daemon, so it shows on the strip (and in this preview)
// at once, and undo covers it.
//
// The window keeps no rules of its own. Pointer and key events go to Rust
// in strip pixels; Rust works out what they mean and sends back the zones
// to draw.

import { Button, VerticalBox, HorizontalBox, Palette, LineEdit, ComboBox, TextEdit, ScrollView, ListView } from "std-widgets.slint";

/// One widget on the page, in strip pixels.
export struct Zone {
    x: int,
    width: int,
    name: string,
}

/// One signal in the signal browser.
/// A layout, and whether it is the one on the strip.
export struct LayoutRow {
    name: string,
    active: bool,
}

/// A check that failed, from the same checks as `nexusctl doctor`.
export struct Problem {
    what: string,
    detail: string,
    fix: string,
}

export struct SignalRow {
    name: string,
    /// Its latest value, in the display units.
    value: string,
}

/// One setting of the selected widget, as the inspector lists it.
export struct Field {
    key: string,
    label: string,
    /// "text", "number", "choice", "note" or "signal".
    kind: string,
    value: string,
    /// For a choice: the options, and which one is `value` (-1 if none).
    choices: [string],
    index: int,
    help: string,
}

// A field: its label, the control for its kind, and help under it. Text is
// sent when Enter is pressed or focus leaves, not on every key.
component FieldRow inherits HorizontalLayout {
    in property <Field> field;
    /// The label of the field a signal is being chosen for, or empty.
    in property <string> choosing-for;
    callback changed(string, string);
    callback choose(string);
    spacing: 12px;

    Text {
        text: root.field.label;
        width: 150px;
        y: 6px;
        vertical-alignment: top;
        horizontal-alignment: right;
        color: Palette.foreground.transparentize(0.2);
    }

    VerticalLayout {
        spacing: 2px;
        horizontal-stretch: 1;

        if root.field.kind == "signal": HorizontalLayout {
            spacing: 6px;
            LineEdit {
                text: root.field.value;
                accessible-label: root.field.label;
                accepted(text) => {
                    root.changed(root.field.key, text);
                }
                changed has-focus => {
                    if !self.has-focus && self.text != root.field.value {
                        root.changed(root.field.key, self.text);
                    }
                }
            }
            Button {
                text: root.choosing-for == root.field.label ? "Choosing…" : "Choose…";
                accessible-label: "Choose the " + root.field.label + " from the signal list";
                clicked => {
                    root.choose(root.field.key);
                }
            }
        }
        if root.field.kind == "text" || root.field.kind == "number": LineEdit {
            text: root.field.value;
            input-type: root.field.kind == "number" ? InputType.decimal : InputType.text;
            accessible-label: root.field.label;
            accepted(text) => {
                root.changed(root.field.key, text);
            }
            changed has-focus => {
                if !self.has-focus && self.text != root.field.value {
                    root.changed(root.field.key, self.text);
                }
            }
        }
        if root.field.kind == "choice": ComboBox {
            model: root.field.choices;
            current-index: root.field.index;
            accessible-label: root.field.label;
            selected(value) => {
                root.changed(root.field.key, value);
            }
        }
        if root.field.kind == "note": TextEdit {
            text: root.field.value;
            height: 64px;
            wrap: word-wrap;
            accessible-label: root.field.label;
            changed has-focus => {
                if !self.has-focus && self.text != root.field.value {
                    root.changed(root.field.key, self.text);
                }
            }
        }
        if root.field.help != "": Text {
            text: root.field.help;
            font-size: 12px;
            wrap: word-wrap;
            color: Palette.foreground.transparentize(0.4);
        }
    }
}

/// The layouts in Strip settings: each with Show and Delete, the name of
/// the one on the strip, and Add layout from a copy, empty or a starter.
component LayoutsSection inherits VerticalLayout {
    in property <[LayoutRow]> layouts;
    in property <string> layout-name;
    in property <[string]> choices;
    in property <int> resets;
    in property <bool> enabled;
    callback use(int);
    callback delete(int);
    callback rename(string);
    callback add(string);
    callback import();
    callback export();

    spacing: 8px;
    padding-top: 16px;

    Text {
        text: "Layouts";
        font-size: 15px;
        font-weight: 600;
        accessible-role: text;
    }
    Text {
        text: "A layout is a set of pages and takeovers. The settings above apply to every layout.";
        font-size: 12px;
        wrap: word-wrap;
        color: Palette.foreground.transparentize(0.4);
    }
    for l[i] in root.layouts: HorizontalLayout {
        spacing: 8px;
        Text {
            text: l.active ? l.name + "  ·  on the strip" : l.name;
            font-weight: l.active ? 600 : 400;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
            accessible-role: text;
        }
        Button {
            text: "Show";
            enabled: root.enabled && !l.active;
            accessible-label: "Show layout " + l.name + " on the strip";
            clicked => {
                root.use(i);
            }
        }
        Button {
            text: "Delete";
            enabled: root.enabled && !l.active;
            accessible-label: "Delete layout " + l.name;
            clicked => {
                root.delete(i);
            }
        }
    }
    HorizontalLayout {
        spacing: 12px;
        Text {
            text: "Name";
            width: 150px;
            vertical-alignment: center;
            horizontal-alignment: right;
            color: Palette.foreground.transparentize(0.2);
        }
        // Made anew after a refused name, so it starts from the real one.
        for item in [{ name: root.layout-name, epoch: root.resets }]: LineEdit {
            property <string> name: item.name;
            text: item.name;
            enabled: root.enabled;
            accessible-label: "Name of the layout on the strip";
            accepted(text) => {
                root.rename(text);
            }
            changed has-focus => {
                if !self.has-focus && self.text != self.name {
                    root.rename(self.text);
                }
            }
        }
    }
    HorizontalLayout {
        spacing: 12px;
        Text {
            text: "Add layout";
            width: 150px;
            vertical-alignment: center;
            horizontal-alignment: right;
            color: Palette.foreground.transparentize(0.2);
        }
        from-choice := ComboBox {
            model: root.choices;
            enabled: root.enabled;
            horizontal-stretch: 1;
            accessible-label: "What the new layout starts from";
        }
        Button {
            text: "Add";
            enabled: root.enabled;
            accessible-label: "Add a layout from " + from-choice.current-value + " and show it";
            clicked => {
                root.add(from-choice.current-value);
            }
        }
    }
    HorizontalLayout {
        spacing: 12px;
        Text {
            text: "Files";
            width: 150px;
            vertical-alignment: center;
            horizontal-alignment: right;
            color: Palette.foreground.transparentize(0.2);
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Button {
                text: "Import from file…";
                enabled: root.enabled;
                clicked => {
                    root.import();
                }
            }
            Button {
                text: "Export this layout…";
                enabled: root.enabled;
                clicked => {
                    root.export();
                }
            }
        }
    }
    HorizontalLayout {
        padding-left: 162px;
        Text {
            text: "A new or imported layout goes on the strip; undo takes it back. An exported file holds the pages, takeovers and settings, but not where the weather is for or the sources.";
            font-size: 12px;
            wrap: word-wrap;
            color: Palette.foreground.transparentize(0.4);
        }
    }
}

export component AppWindow inherits Window {
    title: "Nexus Open";
    icon: @image-url("../assets/icon.png");
    min-width: 720px;
    min-height: 320px;
    preferred-width: 1340px;
    preferred-height: 820px;
    background: Palette.background;

    /// The frame on the strip, 640×48, exactly as the daemon sent it.
    in property <image> frame;
    /// False while the daemon cannot be reached.
    in property <bool> connected;
    /// The checks that failed, each with its fix; empty when all is well.
    in property <[Problem]> problems;
    /// Every check and the system, to paste into a bug report.
    in property <string> diagnostics;
    /// Run the checks again now.
    callback check-again();
    /// Every layout; the name of the one on the strip; what a new one can
    /// start from. Bumped when a typed layout name is refused.
    in property <[LayoutRow]> layouts;
    in property <string> layout-name;
    in property <[string]> layout-choices;
    in property <int> layout-name-resets;
    /// Put layout `i` on the strip; delete it; rename the one on the
    /// strip; add one from a choice and put it on the strip.
    callback use-layout(int);
    callback delete-layout(int);
    callback rename-layout(string);
    callback add-layout(string);
    /// Add a layout from a file; save the one on the strip as a file.
    callback import-layout();
    callback export-layout();
    property <bool> copied;

    // Copies through a text input's own clipboard support, which works on
    // every platform Slint runs on. Never shown.
    clip := TextInput {
        visible: false;
        text: root.diagnostics;
    }

    function copy-diagnostics() {
        clip.select-all();
        clip.copy();
        clip.clear-selection();
        root.copied = true;
    }

    Timer {
        interval: 2s;
        running: root.copied;
        triggered => {
            root.copied = false;
        }
    }
    /// The page on the strip, and its position ("2 of 4").
    in property <string> page-name;
    in property <string> page-position;
    /// Every page's name, in order, and which one is on the strip (-1
    /// while unknown).
    in property <[string]> pages;
    in property <int> current-page: -1;
    /// Every takeover's name, and which one is being edited (-1 if none).
    in property <[string]> takeovers;
    in property <int> current-takeover: -1;
    /// What the settings area holds besides a widget or the page:
    /// "new-takeover", "takeover", "settings", or empty.
    in property <string> form;
    /// Bumped when a typed page name is refused, to put the real one back.
    in property <int> page-name-resets;

    /// The widgets of the page on the strip.
    in property <[Zone]> zones;
    /// Index into `zones`, or -1.
    in property <int> selected: -1;
    /// False while there is nothing to edit: no layout yet, a takeover
    /// covering the page, or a store that cannot be written.
    in property <bool> editable;
    /// Under the preview: the selection, a drag in progress, or why the
    /// page cannot be edited right now.
    in property <string> caption;
    /// What went wrong with the last change, until the next one.
    in property <string> problem;
    /// While a widget is dragged: where it is drawn and the gap it would
    /// drop into, in strip pixels; `ghost-width` 0 when not dragging.
    in property <float> ghost-x;
    in property <int> ghost-width;
    in property <int> drop-x;
    /// The selected widget's settings; empty when none is selected.
    in property <[Field]> fields;
    /// What is still missing before a half-made change can be saved.
    in property <string> draft-hint;
    /// What undo and redo would do; empty when there is nothing.
    in property <string> undo-label;
    in property <string> redo-label;
    /// The signal browser: the signals matching the filter, and how many
    /// there are in all.
    in property <[SignalRow]> signal-rows;
    in property <int> signal-count;
    /// The label of the field a signal is being chosen for, or empty.
    in property <string> choosing-for;

    /// Pages: show page `i` on the strip; add one after it; rename it;
    /// move it earlier (-1) or later (1); delete it.
    callback show-page(int);
    callback add-page();
    callback rename-page(string);
    callback move-page(int);
    callback delete-page();
    /// Takeovers: show takeover `i` on the strip to edit it; start a new
    /// one; delete the one being edited (or drop the new one).
    callback edit-takeover(int);
    callback add-takeover();
    /// Show the strip's own settings: units, clock, font, weather.
    callback open-settings();
    callback delete-takeover();
    /// Pointer on the strip, in strip pixels; a press also says how near
    /// an edge counts as on it.
    callback pressed(float, float);
    callback dragged(float);
    callback released(float);
    callback cancelled();
    /// The widget whose right edge is within `reach` of x, or -1.
    pure callback edge-at(float, float) -> int;
    /// Keyboard: select the widget `step` along; move the selected one;
    /// widen (positive) or narrow it by pixels; drop the selection.
    callback select-step(int);
    callback move-step(int);
    callback resize-step(int);
    callback deselect();
    callback undo();
    callback redo();
    /// A field of the selected widget changed: its key and new value.
    callback field-changed(string, string);
    /// After the selection, or at the end with nothing selected.
    callback add-widget();
    callback delete-widget();
    /// Signal browser: choose a signal for the field with this key, stop
    /// choosing, a signal clicked, the filter typed, Enter in the filter.
    callback choose-signal(string);
    callback cancel-choose();
    callback signal-picked(string);
    callback signal-filter(string);
    callback pick-first();

    // Undo and redo work wherever focus is: this scope holds everything,
    // so it sees every key first.
    FocusScope {
        width: parent.width;
        height: parent.height;
            capture-key-pressed(event) => {
                if !event.modifiers.control || (event.text.to-lowercase() != "z" && event.text.to-lowercase() != "y") {
                    return reject;
                }
                if event.text.to-lowercase() == "y" || event.modifiers.shift {
                    root.redo();
                } else {
                    root.undo();
                }
                accept
            }

        VerticalBox {
            HorizontalBox {
                padding: 0;
                Text {
                    text: "Strip preview";
                    font-size: 18px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                Text {
                    text: !root.connected ? ""
                        : root.layouts.length > 1 && root.current-takeover < 0 && root.page-name != ""
                            ? root.layout-name + "  ·  " + root.page-name + "  ·  page " + root.page-position
                        : root.current-takeover >= 0 ? root.takeovers[root.current-takeover] + "  ·  takeover"
                        : root.page-name != "" ? root.page-name + "  ·  page " + root.page-position : "";
                    color: Palette.foreground.transparentize(0.35);
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                Button {
                    text: "Settings";
                    enabled: root.connected;
                    primary: root.form == "settings";
                    clicked => {
                        root.open-settings();
                    }
                }

                Button {
                    text: root.undo-label == "" ? "Undo" : "Undo: " + root.undo-label;
                    enabled: root.connected && root.undo-label != "";
                    clicked => {
                        root.undo();
                    }
                }

                Button {
                    text: root.redo-label == "" ? "Redo" : "Redo: " + root.redo-label;
                    enabled: root.connected && root.redo-label != "";
                    clicked => {
                        root.redo();
                    }
                }

            }

            // Onboarding: shown only when something is wrong, naming each
            // problem and its fix. The fixes can be selected and copied.
            if !root.connected || root.problems.length > 0: Rectangle {
                background: #e0a00030;
                border-radius: 6px;
                VerticalLayout {
                    padding: 10px;
                    spacing: 6px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: !root.connected
                                ? "Not connected to nexusd. This window reconnects by itself once it runs."
                                : "Something needs fixing before the strip works fully.";
                            font-weight: 600;
                            wrap: word-wrap;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            accessible-role: text;
                        }
                        Button {
                            text: "Check again";
                            clicked => {
                                root.check-again();
                            }
                        }
                        Button {
                            text: root.copied ? "Copied" : "Copy diagnostics";
                            enabled: root.diagnostics != "";
                            clicked => {
                                root.copy-diagnostics();
                            }
                        }
                    }
                    for p in root.problems: VerticalLayout {
                        spacing: 2px;
                        Text {
                            text: p.what + ": " + p.detail;
                            wrap: word-wrap;
                            accessible-role: text;
                        }
                        if p.fix != "": TextInput {
                            text: p.fix;
                            read-only: true;
                            single-line: false;
                            wrap: word-wrap;
                            font-family: "monospace";
                            color: Palette.foreground.transparentize(0.15);
                            accessible-label: "How to fix " + p.what;
                        }
                    }
                }
            }

            preview-area := Rectangle {
                vertical-stretch: 0;
                min-height: 48phx;
                preferred-height: 48phx * 2 + 24px;

                // Largest whole-number scale that fits, counted in physical
                // pixels (phx), not logical ones (px). With fractional desktop
                // scaling a logical-pixel scale would land between device
                // pixels and blur the strip's hinted text.
                property <int> scale: max(1, min(
                    floor(self.width / 640phx),
                    floor(self.height / 48phx)));
                // One strip pixel on screen.
                property <length> unit: 1phx * self.scale;

                strip := Image {
                    source: root.frame;
                    image-rendering: pixelated;
                    width: 640 * preview-area.unit;
                    height: 48 * preview-area.unit;
                    // Rounded to whole physical pixels for the same reason.
                    x: round((parent.width - self.width) / 2 / 1phx) * 1phx;
                    y: round((parent.height - self.height) / 2 / 1phx) * 1phx;
                    opacity: root.connected ? 1 : 0.4;
                    accessible-role: image;
                    accessible-label: "Strip preview, showing page " + root.page-name;
                }

                // The list of widgets for keyboards and screen readers, laid
                // exactly over the strip so the outlines are its items.
                keys := FocusScope {
                    x: strip.x;
                    y: strip.y;
                    width: strip.width;
                    height: strip.height;
                    accessible-role: list;
                    accessible-label: "Widgets on page " + root.page-name
                        + ". Left and right arrows select; with Control they move the widget, with Shift they resize it.";
                    key-pressed(event) => {
                        if !root.editable {
                            return reject;
                        }
                        if event.text == Key.LeftArrow || event.text == Key.RightArrow {
                            let step = event.text == Key.LeftArrow ? -1 : 1;
                            if event.modifiers.control {
                                root.move-step(step);
                            } else if event.modifiers.shift {
                                root.resize-step(step * 4);
                            } else {
                                root.select-step(step);
                            }
                            return accept;
                        }
                        if event.text == Key.Delete && root.selected >= 0 {
                            root.delete-widget();
                            return accept;
                        }
                        if event.text == Key.Escape {
                            root.cancelled();
                            root.deselect();
                            return accept;
                        }
                        reject
                    }

                    if root.editable: Rectangle {
                        width: parent.width;
                        height: parent.height;

                        for zone[i] in root.zones: Rectangle {
                            x: zone.x * preview-area.unit;
                            width: zone.width * preview-area.unit;
                            border-width: i == root.selected ? 2px : 1px;
                            border-color: i == root.selected ? Palette.accent-background : #ffffff38;
                            background: i == root.selected ? Palette.accent-background.transparentize(0.85) : transparent;
                            accessible-role: list-item;
                            accessible-label: zone.name + ", " + zone.width + " pixels wide";
                            accessible-item-selectable: true;
                            accessible-item-selected: i == root.selected;
                            accessible-item-index: i;
                        }

                        if root.ghost-width > 0: Rectangle {
                            x: root.ghost-x * preview-area.unit;
                            width: root.ghost-width * preview-area.unit;
                            border-width: 2px;
                            border-color: Palette.accent-background;
                            background: Palette.accent-background.transparentize(0.6);
                        }
                        if root.ghost-width > 0: Rectangle {
                            x: root.drop-x * preview-area.unit - 2px;
                            width: 4px;
                            background: Palette.accent-background;
                        }

                        touch := TouchArea {
                            property <float> at: self.mouse-x / preview-area.unit;
                            property <float> reach: 4px / preview-area.unit;
                            property <int> edge: root.edge-at(self.at, self.reach);
                            mouse-cursor: self.edge >= 0 ? MouseCursor.ew-resize
                                : self.pressed ? MouseCursor.grabbing : MouseCursor.pointer;
                            pointer-event(event) => {
                                if event.button != PointerEventButton.left {
                                    return;
                                }
                                if event.kind == PointerEventKind.down {
                                    keys.focus();
                                    root.pressed(self.at, self.reach);
                                } else if event.kind == PointerEventKind.up {
                                    root.released(self.at);
                                } else if event.kind == PointerEventKind.cancel {
                                    root.cancelled();
                                }
                            }
                            moved => {
                                root.dragged(self.at);
                            }
                        }
                    }
                }
            }

            // The caption, or what went wrong with the last change. In the
            // same place, so a problem appearing moves nothing under the
            // pointer.
            Text {
                text: root.problem != "" ? root.problem : root.caption;
                color: root.problem != "" ? #e05050 : Palette.foreground.transparentize(0.25);
                horizontal-alignment: center;
                wrap: word-wrap;
                accessible-role: text;
            }

            HorizontalBox {
                padding: 0;

                // The pages, in order: a click shows that page on the strip.
                for name[i] in root.pages: Button {
                    text: name;
                    primary: i == root.current-page;
                    enabled: root.connected;
                    accessible-label: name + ", page " + (i + 1) + " of " + root.pages.length
                        + (i == root.current-page ? ", on the strip" : "");
                    clicked => {
                        root.show-page(i);
                    }
                }

                Button {
                    text: "Add page";
                    enabled: root.connected && root.editable;
                    clicked => {
                        root.add-page();
                    }
                }

                if root.takeovers.length > 0: Text {
                    text: "Takeovers";
                    vertical-alignment: center;
                    color: Palette.foreground.transparentize(0.4);
                }

                // Takeovers: a click shows one on the strip to edit it.
                for name[i] in root.takeovers: Button {
                    text: name;
                    primary: i == root.current-takeover;
                    enabled: root.connected;
                    accessible-label: name + ", takeover" + (i == root.current-takeover ? ", being edited" : "");
                    clicked => {
                        root.edit-takeover(i);
                    }
                }

                Button {
                    text: "Add takeover";
                    enabled: root.connected;
                    clicked => {
                        root.add-takeover();
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                }
            }

            // The inspector: the selected widget's settings.
            Rectangle {
                height: 1px;
                background: Palette.border;
            }

            HorizontalLayout {
                spacing: 12px;
                vertical-stretch: 1;

                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 6px;
                HorizontalBox {
                    padding: 0;
                    Text {
                        text: root.selected >= 0 ? "Widget settings"
                            : root.form == "new-takeover" ? "New takeover"
                            : root.form == "takeover" ? "Takeover settings"
                            : root.form == "settings" ? "Strip settings" : "Page settings";
                        font-size: 16px;
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    if root.form != "new-takeover" && root.form != "settings": Button {
                        text: root.selected >= 0 ? "Add widget after" : "Add widget";
                        enabled: root.connected && root.editable;
                        clicked => {
                            root.add-widget();
                        }
                    }
                    if root.form == "settings": Button {
                        text: root.copied ? "Copied" : "Copy diagnostics";
                        enabled: root.diagnostics != "";
                        clicked => {
                            root.copy-diagnostics();
                        }
                    }
                    if root.selected < 0 && (root.form == "new-takeover" || root.form == "takeover"): Button {
                        text: root.form == "new-takeover" ? "Cancel" : "Delete takeover";
                        enabled: root.connected;
                        clicked => {
                            root.delete-takeover();
                        }
                    }
                    if root.selected >= 0: Button {
                        text: "Delete widget";
                        enabled: root.connected && root.editable;
                        clicked => {
                            root.delete-widget();
                        }
                    }
                }

                // With no widget selected: the page on the strip.
                // The spacer takes the room past 760 px; without it the cap
                // would become the whole window's maximum width.
                if root.selected < 0 && root.editable && root.form == "": HorizontalLayout {
                    vertical-stretch: 1;
                VerticalLayout {
                    spacing: 8px;
                    alignment: start;
                    max-width: 760px;

                    HorizontalLayout {
                        spacing: 12px;
                        Text {
                            text: "Name";
                            width: 150px;
                            y: 6px;
                            vertical-alignment: top;
                            horizontal-alignment: right;
                            color: Palette.foreground.transparentize(0.2);
                        }
                        // Made anew for each page, and after a name is
                        // refused, so it always starts from the real name.
                        for item in [{ name: root.page-name, epoch: root.page-name-resets }]: LineEdit {
                            property <string> name: item.name;
                            text: item.name;
                            accessible-label: "Page name";
                            accepted(text) => {
                                root.rename-page(text);
                            }
                            changed has-focus => {
                                if !self.has-focus && self.text != self.name {
                                    root.rename-page(self.text);
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        padding-left: 162px;
                        alignment: start;
                        Button {
                            text: "Move earlier";
                            enabled: root.connected && root.current-page > 0;
                            clicked => {
                                root.move-page(-1);
                            }
                        }
                        Button {
                            text: "Move later";
                            enabled: root.connected && root.current-page < root.pages.length - 1;
                            clicked => {
                                root.move-page(1);
                            }
                        }
                        Button {
                            text: "Delete page";
                            enabled: root.connected && root.pages.length > 1;
                            clicked => {
                                root.delete-page();
                            }
                        }
                    }
                    HorizontalLayout {
                        padding-left: 162px;
                        Text {
                            text: "Taps that open this page follow a new name. Select a widget on the strip to change it instead.";
                            font-size: 12px;
                            wrap: word-wrap;
                            color: Palette.foreground.transparentize(0.4);
                        }
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                }

                // Always one line tall, so the hint appearing moves no field
                // from under the pointer.
                Text {
                    height: 20px;
                    text: root.draft-hint == "" ? "" : "Not saved yet: " + root.draft-hint;
                    color: #e0a000;
                    overflow: elide;
                    vertical-alignment: center;
                    accessible-role: text;
                }

                scroll := ScrollView {
                    vertical-stretch: 1;
                    min-height: 120px;
                    visible: root.fields.length > 0;

                    VerticalLayout {
                        width: min(scroll.visible-width, 760px);
                        alignment: start;
                        spacing: 8px;
                        padding-right: 12px;
                        for field in root.fields: FieldRow {
                            field: field;
                            choosing-for: root.choosing-for;
                            changed(key, value) => {
                                root.field-changed(key, value);
                            }
                            choose(key) => {
                                root.choose-signal(key);
                                filter.focus();
                            }
                        }
                        if root.form == "settings": LayoutsSection {
                            layouts: root.layouts;
                            layout-name: root.layout-name;
                            choices: root.layout-choices;
                            resets: root.layout-name-resets;
                            enabled: root.connected;
                            use(i) => {
                                root.use-layout(i);
                            }
                            delete(i) => {
                                root.delete-layout(i);
                            }
                            rename(name) => {
                                root.rename-layout(name);
                            }
                            add(choice) => {
                                root.add-layout(choice);
                            }
                            import => {
                                root.import-layout();
                            }
                            export => {
                                root.export-layout();
                            }
                        }
                    }
                }
                }

                Rectangle {
                    width: 1px;
                    background: Palette.border;
                }

                // The signal browser: every signal and its live value. While
                // a field's "Choose…" is active, a click puts the signal in
                // that field.
                VerticalLayout {
                    min-width: 240px;
                    preferred-width: 360px;
                    max-width: 360px;
                    horizontal-stretch: 0;
                    spacing: 6px;

                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Signals";
                            font-size: 16px;
                            font-weight: 600;
                        }
                        Text {
                            text: root.signal-count == 0 ? "none yet" : root.signal-count + " live";
                            color: Palette.foreground.transparentize(0.4);
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                    }

                    filter := LineEdit {
                        placeholder-text: "Filter by name";
                        accessible-label: "Filter signals by name";
                        edited(text) => {
                            root.signal-filter(text);
                        }
                        accepted => {
                            if root.choosing-for != "" {
                                root.pick-first();
                                self.text = "";
                                root.signal-filter("");
                            }
                        }
                        key-pressed(event) => {
                            if event.text == Key.Escape && root.choosing-for != "" {
                                root.cancel-choose();
                                return accept;
                            }
                            reject
                        }
                    }

                    ListView {
                        vertical-stretch: 1;
                        min-height: 120px;
                        for signal in root.signal-rows: Rectangle {
                            height: 36px;
                            background: pick.has-hover && root.choosing-for != "" ? Palette.accent-background.transparentize(0.8) : transparent;
                            border-radius: 4px;
                            accessible-role: list-item;
                            accessible-label: signal.name + ", " + signal.value;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 8px;
                                Text {
                                    text: signal.name;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text: signal.value;
                                    vertical-alignment: center;
                                    horizontal-alignment: right;
                                    overflow: elide;
                                    max-width: 160px;
                                    color: Palette.foreground.transparentize(0.3);
                                }
                            }
                            pick := TouchArea {
                                mouse-cursor: root.choosing-for != "" ? MouseCursor.pointer : MouseCursor.default;
                                clicked => {
                                    if root.choosing-for != "" {
                                        root.signal-picked(signal.name);
                                        filter.text = "";
                                        root.signal-filter("");
                                    }
                                }
                            }
                        }
                    }

                    if root.choosing-for != "": HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Click a signal for " + root.choosing-for + ", or type part of its name and press Enter.";
                            color: Palette.accent-background;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                            accessible-role: text;
                        }
                        Button {
                            text: "Cancel";
                            clicked => {
                                root.cancel-choose();
                            }
                        }
                    }
                }
            }
        }

    }
}
