// The settings window: a storyboard of the layout. Every page is a live
// strip, stacked in order, each named, with the page on the strip marked;
// takeovers follow as their own group. Click a strip to edit it (it goes on
// the real strip), click a widget on it to select it, and its settings open
// right under it. Drag a widget to move it, drag its grip to resize it.
// Every change is an edit sent to the daemon, so it shows on the strip at
// once, and undo covers it.
//
// The window keeps no rules of its own. Pointer and key events go to Rust
// in strip pixels; Rust works out what they mean and sends back what to
// draw. Pictures of the strip are either the daemon's live frame (the page
// on the strip) or drawn by Rust with the strip's own renderer (thumbs.rs).

import { AboutSlint, ScrollView, Palette, ListView } from "std-widgets.slint";
import { Theme, Icon, Glyph } from "theme.slint";
import { Button, IconButton, Segmented, Chip, TextField, Select, MenuRow, MenuDivider, KeyCap, Shortcut, Label, Hint, Heading, FocusRing } from "controls.slint";
import { Field, FieldRow, PickRow, Trigger, Grid } from "form.slint";

export { Theme, Field, PickRow, Trigger }

/// One widget on the strip being edited, in strip pixels.
export struct Zone {
    x: int,
    width: int,
    name: string,
}

/// A page or takeover in the storyboard.
export struct StripRow {
    /// "page", "takeover" or "new-takeover".
    kind: string,
    /// Its place among the pages, or among the takeovers.
    index: int,
    name: string,
    /// Drawn by the window; the live strip's frame replaces it while this
    /// is on the strip.
    frame: image,
    /// Under the name: "4 widgets", "When the track changes · 5 s".
    summary: string,
    /// On the strip right now.
    live: bool,
    /// The one being edited (or tried).
    active: bool,
    empty: bool,
    /// The first takeover: the group's heading goes above it.
    first-takeover: bool,
    /// The last page: "Add page" goes after it.
    last-page: bool,
}

/// A layout, and whether it is the one on the strip.
export struct LayoutRow {
    name: string,
    active: bool,
}

/// One signal in the drawer.
export struct SignalRow {
    name: string,
    id: string,
    icon: string,
    value: string,
}

/// Something to add, in the gallery.
export struct Tile {
    name: string,
    about: string,
    image: image,
    /// Its width on the strip, in strip pixels.
    width: int,
    group: int,
    /// Its place within its group.
    slot: int,
}

/// A starting layout, with a picture of its first page.
export struct Starter {
    name: string,
    about: string,
    image: image,
}

/// The header's status: see status.rs.
export struct StatusView {
    tone: string,
    chip: string,
    headline: string,
    body: string,
    start: bool,
    retry: bool,
    log: bool,
    detail: string,
}

/// A modal sheet over the window: a title, a close button, and whatever
/// it holds. Escape or a click outside closes it.
component Sheet inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <length> sheet-width: 720px;
    callback close();
    background: Theme.scrim;
    TouchArea {
        clicked => {
            root.close();
        }
    }
    card := Rectangle {
        width: min(root.sheet-width, root.width - 32px);
        height: min(inner.preferred-height + 64px, root.height - 48px);
        x: (root.width - self.width) / 2;
        y: max(24px, (root.height - self.height) / 2);
        background: Theme.surface;
        border-radius: 14px;
        border-width: 1px;
        border-color: Theme.line;
        drop-shadow-blur: 30px;
        drop-shadow-color: #00000070;
        clip: true;
        TouchArea { }
        FocusScope {
            init => {
                self.focus();
            }
            key-pressed(event) => {
                if event.text == Key.Escape {
                    root.close();
                    return accept;
                }
                reject
            }
        }
        VerticalLayout {
            HorizontalLayout {
                height: 60px;
                padding-left: 24px;
                padding-right: 12px;
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Text {
                        text: root.title;
                        font-family: Theme.font;
                        font-size: Theme.size-heading;
                        font-weight: 600;
                        color: Theme.text;
                        accessible-role: text;
                    }
                    if root.subtitle != "": Text {
                        text: root.subtitle;
                        font-family: Theme.font;
                        font-size: Theme.size-label;
                        color: Theme.text-3;
                        overflow: elide;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: Glyph.close;
                        label: @tr("Close");
                        clicked => {
                            root.close();
                        }
                    }
                }
            }
            body := ScrollView {
                vertical-stretch: 1;
                inner := VerticalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    padding-bottom: 24px;
                    padding-top: 4px;
                    @children
                }
            }
        }
    }
}

/// The product's mark: a strip with one lit key, as a small rounded pill.
component Mark inherits Rectangle {
    in property <length> size: 28px;
    width: size;
    height: size;
    border-radius: size * 0.3;
    background: #241e1a;
    border-width: 1px;
    border-color: #4a3e35;
    accessible-role: none;
    Rectangle {
        x: parent.width * 0.16;
        y: parent.height * 0.36;
        width: parent.width * 0.42;
        height: parent.height * 0.28;
        border-radius: self.height / 2;
        background: #e6d6c0;
    }
    Rectangle {
        x: parent.width * 0.64;
        y: parent.height * 0.3;
        width: parent.height * 0.4;
        height: parent.height * 0.4;
        border-radius: self.height / 2;
        background: Theme.act;
    }
}

export component AppWindow inherits Window {
    title: @tr("Nexus Open");
    icon: @image-url("../assets/icon.png");
    preferred-width: 1340px;
    preferred-height: 820px;
    min-width: 1024px;
    min-height: 640px;
    background: Theme.ground;
    default-font-family: Theme.font;
    default-font-size: Theme.size-body;

    // ---- From Rust ------------------------------------------------------

    /// The frame on the strip, 640×48, exactly as the daemon sent it.
    in property <image> frame;
    /// False while the daemon cannot be reached.
    in property <bool> connected;
    in property <StatusView> status;
    /// Every check and the system, to paste into a bug report.
    in property <string> diagnostics;
    in property <string> version;
    in property <string> daemon-version;
    in property <string> homepage;
    /// Try mode: the strip being edited acts as the strip.
    in property <bool> trying;
    /// The storyboard.
    in property <[StripRow]> rows;
    in property <int> takeover-count;
    in property <int> page-count;
    /// Layouts: every one, and the one on the strip.
    in property <[LayoutRow]> layouts;
    in property <string> layout-name;
    /// The widgets on the strip being edited.
    in property <[Zone]> zones;
    in property <int> selected: -1;
    /// While a resize is dragged: it landed on a snap point here (x), or -1.
    in property <int> snap-x: -1;
    /// False while there is nothing to edit (disconnected, a store that
    /// cannot be written, a takeover covering the page).
    in property <bool> editable;
    in property <string> caption;
    in property <string> problem;
    in property <float> ghost-x;
    in property <int> ghost-width;
    in property <int> drop-x;
    /// The settings under the strip being edited: what they are for
    /// ("widget", "page", "takeover", "new-takeover"), its title and icon.
    in property <string> panel-kind;
    in property <string> panel-title;
    in property <string> panel-icon;
    in property <string> panel-note;
    in property <[Field]> fields;
    in property <string> draft-hint;
    /// Undo and redo: what they would do; empty when nothing.
    in property <string> undo-label;
    in property <string> redo-label;
    /// The picker's rows (for whichever field opened it) and the drawer's.
    in property <[PickRow]> picks;
    in property <[Trigger]> triggers;
    in property <[SignalRow]> signal-rows;
    /// Add: whether anything fits, and why not.
    in property <bool> can-add;
    in property <string> add-reason;
    in property <[Tile]> tiles;
    in property <[string]> groups;
    in property <[int]> group-sizes;
    in property <string> gallery-note;
    in property <[Starter]> starters;
    /// A fresh store: offer the starters.
    in property <bool> first-run;
    /// Preferences.
    in property <int> pref-temperature;
    in property <int> pref-clock;
    in property <string> pref-accent;
    in property <[color]> accent-swatches;
    in property <[string]> accent-names;
    in property <int> accent-current: -1;
    in property <string> accent-note;
    in property <string> pref-weather;
    in property <bool> pref-idle-dim: true;
    in property <bool> pref-night;
    in property <string> pref-night-from;
    in property <string> pref-night-to;
    in property <[string]> fonts;
    in property <int> pref-font;
    in property <string> log-text;
    /// Bumped to put typed names back after a refusal.
    in property <int> resets;
    in property <string> page-name;

    // ---- To Rust --------------------------------------------------------

    callback check-again();
    callback set-trying(bool);
    callback try-press(float);
    callback try-release(float);
    callback try-cancel();
    /// A strip that is not being edited was clicked at x (strip pixels).
    callback strip-clicked(string, int, float);
    callback pressed(float, float);
    callback dragged(float);
    callback released(float);
    callback cancelled();
    pure callback edge-at(float, float) -> int;
    callback select-step(int);
    callback move-step(int);
    callback resize-step(int);
    callback deselect();
    /// 0 match the system, 1 light, 2 dark: the window only.
    callback set-appearance(int);
    callback undo();
    callback redo();
    callback field-changed(string, string);
    callback field-chosen(string, int);
    callback open-picker(string);
    callback picker-filter(string);
    callback picked(string, string);
    callback remove-trigger(string);
    callback open-gallery();
    callback add-tile(int);
    callback delete-widget();
    callback equal-widths();
    callback add-page();
    callback rename-page(string);
    callback move-page(int, int);
    callback delete-page();
    callback add-takeover();
    callback create-takeover();
    callback delete-takeover();
    callback use-layout(int);
    callback rename-layout(string);
    callback duplicate-layout();
    callback new-layout(int);
    callback delete-layout(int);
    callback import-layout();
    callback export-layout();
    callback open-starters();
    callback choose-starter(int);
    callback dismiss-first-run();
    callback set-pref(string, string);
    /// Why the last try to start the service failed; empty if it did not.
    in property <string> start-failure;
    callback start-service();
    callback open-log();

    // ---- Window state ---------------------------------------------------

    /// The open sheet: "", "gallery", "prefs", "about", "starters",
    /// "rename", "log", "status".
    in-out property <string> sheet;
    property <bool> copied;
    /// Pages being reordered by their grip: from and to, or -1.
    property <int> reorder-from: -1;
    property <int> reorder-to: -1;
    property <bool> keys-shown: true;

    /// Strip pixels shown at 2× when the window has room for 1,280 of
    /// them, else at exactly 1×: never a blurry in-between. In physical
    /// pixels, so desktop scaling never puts a strip pixel between two.
    property <length> board-pad: 16px;
    property <length> bezel: 6px;
    property <int> zoom: board.visible-width >= 1280phx + 2 * (board-pad + bezel) ? 2 : 1;
    property <length> unit: 1phx * zoom;
    property <length> strip-w: 640 * unit;
    property <length> strip-h: 48 * unit;
    property <length> column-w: strip-w + 2 * bezel;

    public function show-sheet(name: string) {
        root.sheet = name;
    }

    // The desktop's scheme, for Theme, and Slint's own widgets (scroll
    // bars, the About badge) set to match.
    /// After Theme.forced is set: Slint's own widgets (scroll bars, the
    /// About badge) follow it too. Without it they follow the desktop, as
    /// Theme does.
    public function apply-scheme() {
        // Unknown hands Slint's own widgets back to the desktop's live
        // scheme, which Theme then reads (theme.slint).
        Palette.color-scheme = Theme.forced == 2 ? ColorScheme.dark
            : Theme.forced == 1 ? ColorScheme.light : ColorScheme.unknown;
    }

    // Copies through a text input's own clipboard support. Never shown.
    clip := TextInput {
        visible: false;
        text: root.diagnostics;
    }
    function copy-diagnostics() {
        clip.select-all();
        clip.copy();
        clip.clear-selection();
        root.copied = true;
    }
    Timer {
        interval: 2s;
        running: root.copied;
        triggered => {
            root.copied = false;
        }
    }

    // Undo and redo wherever focus is: this scope holds everything, so it
    // sees every key first.
    FocusScope {
        width: parent.width;
        height: parent.height;
        capture-key-pressed(event) => {
            if !event.modifiers.control || (event.text.to-lowercase() != "z" && event.text.to-lowercase() != "y") {
                return reject;
            }
            if event.text.to-lowercase() == "y" || event.modifiers.shift {
                root.redo();
            } else {
                root.undo();
            }
            accept
        }

        VerticalLayout {
            // ---- Header ----------------------------------------------
            header := Rectangle {
                height: 60px;
                background: Theme.surface;
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.line;
                }
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 10px;
                    alignment: stretch;

                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        VerticalLayout {
                            alignment: center;
                            Mark { }
                        }
                        Text {
                            text: @tr("Nexus Open");
                            font-family: Theme.font;
                            font-size: 17px;
                            font-weight: 600;
                            color: Theme.text;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle {
                        width: 1px;
                        Rectangle {
                            y: 18px;
                            height: 24px;
                            background: Theme.line;
                        }
                    }
                    // The layout switcher.
                    VerticalLayout {
                        alignment: center;
                        layout-button := Button {
                            tier: "quiet";
                            // A fixed width, so a layout's name never moves
                            // Edit / Try it.
                            fit: false;
                            // Narrower in a small window, so the header keeps
                            // its gutter at 1024 px.
                            width: root.width < 1200px ? 150px : 180px;
                            icon: Glyph.stack;
                            text: root.layout-name == "" ? @tr("Layouts") : root.layout-name;
                            label: @tr("Layout {}: switch, rename, duplicate, add, import, export or delete", root.layout-name);
                            enabled: root.connected;
                            clicked => {
                                layout-menu.show();
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Segmented {
                            options: [@tr("Edit"), @tr("Try it")];
                            icons: [Glyph.cursor, Glyph.tap];
                            current: root.trying ? 1 : 0;
                            enabled: root.connected;
                            label: @tr("Mode: Edit selects and changes widgets; Try it sends clicks on the strip as touches");
                            chose(i) => {
                                root.set-trying(i == 1);
                            }
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    // The status chip.
                    VerticalLayout {
                        alignment: center;
                        status-chip := Rectangle {
                            height: 32px;
                            width: max(168px, chip-row.preferred-width);
                            border-radius: 16px;
                            property <bool> trouble: root.status.tone == "warn" || root.status.tone == "stopped";
                            background: trouble ? Theme.warn-surface : chip-touch.has-hover ? Theme.surface-2 : transparent;
                            border-width: trouble ? 1px : 0px;
                            border-color: Theme.warn.transparentize(0.5);
                            accessible-role: button;
                            accessible-label: @tr("Status: {}. Opens the details and fixes.", root.status.chip);
                            accessible-action-default => {
                                status-menu.show();
                            }
                            chip-row := HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 12px;
                                spacing: 7px;
                                Icon {
                                    glyph: root.status.tone == "stopped" ? Glyph.plug : status-chip.trouble ? Glyph.warning : root.status.tone == "note" ? Glyph.info : Glyph.ok;
                                    fill: true;
                                    color: status-chip.trouble ? Theme.warn : Theme.text-3;
                                }
                                Text {
                                    text: root.status.chip == "" ? @tr("Checking…") : root.status.chip;
                                    font-family: Theme.font;
                                    font-size: Theme.size-label;
                                    font-weight: status-chip.trouble ? 600 : 500;
                                    color: status-chip.trouble ? Theme.warn : Theme.text-2;
                                    vertical-alignment: center;
                                }
                            }
                            chip-touch := TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                clicked => {
                                    chip-focus.focus();
                                    status-menu.show();
                                }
                            }
                            chip-focus := FocusScope {
                                // Its ring is for focus reached by the keyboard; a click
                                // focuses it too, and shows the press instead.
                                property <bool> by-keys;
                                focus-gained(reason) => {
                                    self.by-keys = reason == FocusReason.tab-navigation;
                                }
                                // Its TouchArea focuses it; taking the press here would
                                // swallow the first click.
                                focus-on-click: false;
                                key-pressed(event) => {
                                    if event.text == " " || event.text == Key.Return {
                                        status-menu.show();
                                        return accept;
                                    }
                                    reject
                                }
                            }
                            FocusRing {
                                width: parent.width + 8px;
                                height: parent.height + 8px;
                                shown: chip-focus.has-focus && chip-focus.by-keys;
                                radius: 16px;
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        // A fixed width, so a long label never moves the
                        // header's middle.
                        Button {
                            tier: "quiet";
                            fit: false;
                            width: root.width < 1200px ? 170px : 230px;
                            icon: Glyph.undo;
                            text: root.undo-label == "" ? @tr("Undo") : @tr("Undo: {}", root.undo-label);
                            label: root.undo-label == "" ? @tr("Undo: nothing to undo") : @tr("Undo: {}", root.undo-label);
                            enabled: root.connected && root.undo-label != "";
                            clicked => {
                                root.undo();
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        IconButton {
                            icon: Glyph.redo;
                            label: root.redo-label == "" ? @tr("Redo: nothing to redo") : @tr("Redo: {}", root.redo-label);
                            enabled: root.connected && root.redo-label != "";
                            clicked => {
                                root.redo();
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        more-button := IconButton {
                            icon: Glyph.dots;
                            label: @tr("More: preferences, copy diagnostics, about");
                            clicked => {
                                more-menu.show();
                            }
                        }
                    }
                }
            }

            // ---- The storyboard --------------------------------------
            board := ScrollView {
                vertical-stretch: 1;
                content := VerticalLayout {
                    padding-left: root.board-pad;
                    padding-right: root.board-pad;
                    padding-top: 12px;
                    padding-bottom: 40px;
                    alignment: start;

                    HorizontalLayout {
                        alignment: center;
                        column := VerticalLayout {
                            width: root.column-w;
                            spacing: 0px;

                            // Not connected: nothing here is live.
                            if !root.connected: Rectangle {
                                height: offline-row.preferred-height + 20px;
                                border-radius: Theme.r-surface;
                                background: root.start-failure != "" ? Theme.crit-surface : Theme.warn-surface;
                                offline-row := HorizontalLayout {
                                    padding: 10px;
                                    padding-left: 14px;
                                    spacing: 12px;
                                    Icon {
                                        glyph: root.start-failure != "" ? Glyph.warning : Glyph.plug;
                                        color: root.start-failure != "" ? Theme.crit : Theme.warn;
                                        font-size: 18px;
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 4px;
                                        horizontal-stretch: 1;
                                        Text {
                                            text: @tr("Not connected to the strip's service, so editing is paused and these pictures are not live. Nothing is lost: a change waiting to be sent goes out when it is back.");
                                            font-family: Theme.font;
                                            font-size: Theme.size-body;
                                            color: Theme.text;
                                            wrap: word-wrap;
                                            accessible-role: text;
                                        }
                                        // What the last try to start it said: here, as
                                        // there may be no strip to say it under.
                                        if root.start-failure != "": Text {
                                            text: @tr("It did not start. {}", root.start-failure);
                                            font-family: Theme.font;
                                            font-size: Theme.size-body;
                                            font-weight: 600;
                                            color: Theme.crit;
                                            wrap: word-wrap;
                                            accessible-role: text;
                                        }
                                    }
                                    if root.status.start: VerticalLayout {
                                        alignment: center;
                                        // Neutral, not the accent: on a warning ground
                                        // the accent would read as part of the trouble.
                                        Button {
                                            tier: "default";
                                            icon: Glyph.power;
                                            text: root.start-failure != "" ? @tr("Try to start it again") : @tr("Start the service");
                                            clicked => {
                                                root.start-service();
                                            }
                                        }
                                    }
                                }
                            }

                            // Section heading: pages.
                            HorizontalLayout {
                                padding-top: 12px;
                                padding-bottom: 8px;
                                spacing: 10px;
                                Heading {
                                    text: @tr("Pages");
                                    accessible-role: text;
                                }
                                Hint {
                                    text: @tr("Swipe the strip to move between them. Drag a page by its handle to reorder.");
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    wrap: no-wrap;
                                    overflow: elide;
                                }
                            }
                            // Opened while the service is away: nothing read yet.
                            if root.rows.length == 0 && !root.connected: Hint {
                                text: @tr("The pages show here once the service answers.");
                            }

                            for row[ri] in root.rows: block := VerticalLayout {
                                property <bool> active: row.active;
                                property <bool> is-page: row.kind == "page";
                                changed active => {
                                    if self.active {
                                        reveal.running = true;
                                    }
                                }
                                // Brings the strip being edited to the top of the
                                // storyboard once its block has its final size.
                                reveal := Timer {
                                    interval: 60ms;
                                    running: false;
                                    triggered => {
                                        self.running = false;
                                        board.content-y =max(board.visible-height - content.preferred-height, min(0px, -(block.y - 8px)));
                                    }
                                }

                                // The takeovers' heading, above the first.
                                if row.first-takeover: VerticalLayout {
                                    padding-top: 28px;
                                    padding-bottom: 8px;
                                    spacing: 2px;
                                    Heading {
                                        text: @tr("Takeovers");
                                        accessible-role: text;
                                    }
                                    Hint {
                                        text: @tr("A takeover covers the page for a few seconds when a reading changes: the track, the volume. Here it is shown as it would cover your first page.");
                                    }
                                }

                                // The drop line while pages are reordered.
                                if root.reorder-from >= 0 && is-page && root.reorder-to == row.index && root.reorder-to < root.reorder-from: Rectangle {
                                    height: 4px;
                                    border-radius: 2px;
                                    background: Theme.act-line;
                                }

                                // Name line.
                                HorizontalLayout {
                                    height: 34px;
                                    spacing: 8px;
                                    if is-page: Rectangle {
                                        width: 20px;
                                        accessible-role: none;
                                        Icon {
                                            glyph: Glyph.grip;
                                            color: grip.has-hover || grip.pressed ? Theme.text : Theme.text-3;
                                            font-size: 16px;
                                        }
                                        grip := TouchArea {
                                            enabled: root.connected && !root.trying;
                                            mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.grab;
                                            // Rows here are about one strip and its
                                            // name apart.
                                            property <length> pitch: root.strip-h + 2 * root.bezel + 34px + 10px;
                                            pointer-event(event) => {
                                                if event.button != PointerEventButton.left {
                                                    return;
                                                }
                                                if event.kind == PointerEventKind.down {
                                                    root.reorder-from = row.index;
                                                    root.reorder-to = row.index;
                                                } else if event.kind == PointerEventKind.up {
                                                    if root.reorder-from >= 0 && root.reorder-to != root.reorder-from {
                                                        root.move-page(root.reorder-from, root.reorder-to);
                                                    }
                                                    root.reorder-from = -1;
                                                    root.reorder-to = -1;
                                                } else if event.kind == PointerEventKind.cancel {
                                                    root.reorder-from = -1;
                                                    root.reorder-to = -1;
                                                }
                                            }
                                            moved => {
                                                if root.reorder-from >= 0 {
                                                    root.reorder-to = max(0, min(root.page-count - 1,
                                                        row.index + round((self.mouse-y - self.pressed-y) / self.pitch)));
                                                }
                                            }
                                        }
                                    }
                                    if !is-page: Rectangle {
                                        width: 20px;
                                        Icon {
                                            glyph: Glyph.cards;
                                            color: Theme.text-3;
                                            font-size: 16px;
                                        }
                                    }
                                    Text {
                                        text: row.name;
                                        font-family: Theme.font;
                                        font-size: Theme.size-body + 1px;
                                        font-weight: row.active ? 600 : 500;
                                        color: Theme.text;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        accessible-role: none;
                                    }
                                    if row.live && root.connected: VerticalLayout {
                                        alignment: center;
                                        horizontal-stretch: 0;
                                        Rectangle {
                                            height: 22px;
                                            width: live-row.preferred-width;
                                            border-radius: 11px;
                                            background: Theme.surface-2;
                                            live-row := HorizontalLayout {
                                                padding-left: 8px;
                                                padding-right: 9px;
                                                spacing: 5px;
                                                VerticalLayout {
                                                    alignment: center;
                                                    Rectangle {
                                                        width: 7px;
                                                        height: 7px;
                                                        border-radius: 3.5px;
                                                        background: Theme.text;
                                                    }
                                                }
                                                Text {
                                                    text: root.status.tone == "ok" ? @tr("On the strip")
                                                        : row.kind == "page" ? @tr("Current page") : @tr("Showing now");
                                                    font-family: Theme.font;
                                                    font-size: Theme.size-small;
                                                    font-weight: 500;
                                                    color: Theme.text;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                    Text {
                                        text: row.summary;
                                        font-family: Theme.font;
                                        font-size: Theme.size-label;
                                        color: Theme.text-3;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }
                                }

                                // The strip, in its bezel.
                                strip-frame := Rectangle {
                                    height: root.strip-h + 2 * root.bezel;
                                    border-radius: 12px;
                                    background: Theme.bezel;
                                    border-width: row.active ? 2px : 1px;
                                    border-color: row.active && !root.trying ? Theme.text-2 : row.active ? Theme.line-strong : Theme.dark ? Theme.line : Theme.bezel;
                                    accessible-role: button;
                                    accessible-label: row.live && root.status.tone == "ok"
                                        ? @tr("{}, on the strip. {}", row.name, row.summary)
                                        : row.live ? @tr("{}, the current page. {}", row.name, row.summary)
                                        : row.kind == "page" ? @tr("{}, page {}. Shows it on the strip to edit it.", row.name, row.index + 1)
                                        : @tr("{}, takeover. Shows it on the strip to edit it.", row.name);
                                    accessible-action-default => {
                                        root.strip-clicked(row.kind, row.index, -1);
                                    }

                                    strip-image := Image {
                                        x: root.bezel;
                                        y: root.bezel;
                                        width: root.strip-w;
                                        height: root.strip-h;
                                        // The strip's own frame, except on the page being
                                        // edited: there the outlines must sit on its
                                        // widgets, not on an alarm or takeover covering them.
                                        source: row.live && root.connected && (root.trying || !row.active) ? root.frame : row.frame;
                                        image-rendering: pixelated;
                                        accessible-role: none;
                                    }

                                    // A new takeover has no picture yet.
                                    if row.kind == "new-takeover": Rectangle {
                                        x: root.bezel;
                                        y: root.bezel;
                                        width: root.strip-w;
                                        height: root.strip-h;
                                        Text {
                                            text: @tr("Choose what shows it, then add its widgets here");
                                            font-family: Theme.font;
                                            font-size: Theme.size-body;
                                            color: #9c8c7c;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    // Not being edited: a click makes it the one.
                                    if !row.active && row.kind != "new-takeover": Rectangle {
                                        border-radius: 12px;
                                        border-width: pick-strip.has-hover && root.connected ? 2px : 0px;
                                        border-color: Theme.line-strong;
                                        pick-strip := TouchArea {
                                            enabled: root.connected;
                                            mouse-cursor: root.connected ? MouseCursor.pointer : MouseCursor.default;
                                            clicked => {
                                                root.strip-clicked(row.kind, row.index, (self.mouse-x - root.bezel) / root.unit);
                                            }
                                        }
                                    }

                                    // Being edited: the widgets as a list, laid over
                                    // the strip so the outlines are its items.
                                    if row.active: keys := FocusScope {
                                        // Its TouchArea focuses it; taking the press here would
                                        // swallow the first click.
                                        focus-on-click: false;
                                        x: root.bezel;
                                        y: root.bezel;
                                        width: root.strip-w;
                                        height: root.strip-h;
                                        // A widget selected from elsewhere (a click on
                                        // another strip, the gallery) takes the keys too.
                                        property <int> sel: root.selected;
                                        changed sel => {
                                            if self.sel >= 0 && !self.has-focus {
                                                self.focus();
                                            }
                                        }
                                        // Reached by the keyboard: a ring round the
                                        // whole strip, unlike the selection outline,
                                        // which a click also gives.
                                        property <bool> by-keys;
                                        focus-gained(reason) => {
                                            self.by-keys = reason == FocusReason.tab-navigation;
                                        }
                                        FocusRing {
                                            x: -root.bezel - 4px;
                                            y: -root.bezel - 4px;
                                            width: root.strip-w + 2 * root.bezel + 8px;
                                            height: root.strip-h + 2 * root.bezel + 8px;
                                            radius: 13px;
                                            shown: keys.has-focus && keys.by-keys;
                                        }
                                        accessible-role: list;
                                        accessible-label: @tr("Widgets on {}. Left and right arrows select; with Control they move the widget, with Shift they resize it; Delete removes it.", row.name);
                                        key-pressed(event) => {
                                            if !root.editable {
                                                return reject;
                                            }
                                            if event.text == Key.LeftArrow || event.text == Key.RightArrow {
                                                self.by-keys = true;
                                                let step = event.text == Key.LeftArrow ? -1 : 1;
                                                if event.modifiers.control {
                                                    root.move-step(step);
                                                } else if event.modifiers.shift {
                                                    root.resize-step(step * 4);
                                                } else {
                                                    root.select-step(step);
                                                }
                                                return accept;
                                            }
                                            if event.text == Key.Delete && root.selected >= 0 {
                                                root.delete-widget();
                                                return accept;
                                            }
                                            if event.text == Key.Escape {
                                                root.cancelled();
                                                root.deselect();
                                                return accept;
                                            }
                                            reject
                                        }

                                        if root.trying: TouchArea {
                                            property <float> at: self.mouse-x / root.unit;
                                            mouse-cursor: MouseCursor.pointer;
                                            accessible-role: button;
                                            accessible-label: @tr("The strip, to try: a tap or swipe here acts on it");
                                            pointer-event(event) => {
                                                if event.button != PointerEventButton.left {
                                                    return;
                                                }
                                                if event.kind == PointerEventKind.down {
                                                    root.try-press(self.at);
                                                } else if event.kind == PointerEventKind.up {
                                                    root.try-release(self.at);
                                                } else if event.kind == PointerEventKind.cancel {
                                                    root.try-cancel();
                                                }
                                            }
                                        }

                                        if root.editable && !root.trying: Rectangle {
                                            for zone[i] in root.zones: Rectangle {
                                                x: zone.x * root.unit;
                                                width: zone.width * root.unit;
                                                border-radius: 4px * root.zoom;
                                                border-width: i == root.selected ? 2px : 1px;
                                                border-color: i == root.selected ? #d2c2ad : #fbf1e333;
                                                accessible-role: list-item;
                                                accessible-label: @tr("{}, {} pixels wide", zone.name, zone.width);
                                                accessible-item-selectable: true;
                                                accessible-item-selected: i == root.selected;
                                                accessible-item-index: i;
                                            }
                                            if root.snap-x >= 0: Rectangle {
                                                x: root.snap-x * root.unit - 1px;
                                                y: -root.bezel;
                                                width: 2px;
                                                height: parent.height + 2 * root.bezel;
                                                background: Theme.accent-text;
                                            }
                                            if root.ghost-width > 0: Rectangle {
                                                x: root.ghost-x * root.unit;
                                                width: root.ghost-width * root.unit;
                                                border-radius: 4px * root.zoom;
                                                border-width: 2px;
                                                border-color: Theme.accent-base;
                                                background: Theme.accent-base.transparentize(0.7);
                                            }
                                            if root.ghost-width > 0: Rectangle {
                                                x: root.drop-x * root.unit - 2px;
                                                width: 4px;
                                                border-radius: 2px;
                                                background: Theme.accent-base;
                                            }
                                            touch := TouchArea {
                                                property <float> at: self.mouse-x / root.unit;
                                                property <float> reach: 5px / root.unit;
                                                property <int> edge: root.edge-at(self.at, self.reach);
                                                mouse-cursor: self.edge >= 0 ? MouseCursor.ew-resize
                                                    : self.pressed ? MouseCursor.grabbing : MouseCursor.pointer;
                                                pointer-event(event) => {
                                                    if event.button != PointerEventButton.left {
                                                        return;
                                                    }
                                                    if event.kind == PointerEventKind.down {
                                                        keys.focus();
                                                        root.pressed(self.at, self.reach);
                                                    } else if event.kind == PointerEventKind.up {
                                                        root.released(self.at);
                                                    } else if event.kind == PointerEventKind.cancel {
                                                        root.cancelled();
                                                    }
                                                }
                                                moved => {
                                                    root.dragged(self.at);
                                                }
                                            }
                                            // The grip on the selected widget's right edge:
                                            // drag it to resize.
                                            if root.selected >= 0 && root.ghost-width == 0: Rectangle {
                                                property <Zone> zn: root.zones[root.selected];
                                                x: (zn.x + zn.width) * root.unit - self.width / 2;
                                                y: (parent.height - self.height) / 2;
                                                width: 10px;
                                                height: min(30px, parent.height - 6px);
                                                border-radius: 5px;
                                                background: Theme.accent-base;
                                                border-width: 2px;
                                                border-color: #14110f;
                                                accessible-role: none;
                                                Rectangle {
                                                    width: 2px;
                                                    height: parent.height - 12px;
                                                    border-radius: 1px;
                                                    background: #14110f80;
                                                }
                                            }
                                        }
                                        // An empty page: the way to fill it, on it.
                                        if row.empty && root.editable && !root.trying: Rectangle {
                                            x: 4px;
                                            y: 4px;
                                            width: parent.width - 8px;
                                            height: parent.height - 8px;
                                            border-radius: 8px;
                                            border-width: 1.5px;
                                            border-color: Theme.accent-base;
                                            background: empty-touch.has-hover ? #ffffff10 : transparent;
                                            HorizontalLayout {
                                                alignment: center;
                                                spacing: 8px;
                                                Icon {
                                                    glyph: Glyph.plus;
                                                    color: Theme.accent-text;
                                                }
                                                Text {
                                                    text: @tr("Add a widget to this page");
                                                    font-family: Theme.font;
                                                    font-size: Theme.size-body;
                                                    font-weight: 500;
                                                    color: Theme.accent-text;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            empty-touch := TouchArea {
                                                mouse-cursor: MouseCursor.pointer;
                                                clicked => {
                                                    root.open-gallery();
                                                    root.show-sheet("gallery");
                                                }
                                            }
                                        }
                                    }
                                    // Not live: the picture darkens as the strip
                                    // dims, so the bezel stays a device on cream
                                    // too (fading it into the page turned it taupe).
                                    if !root.connected: Rectangle {
                                        border-radius: parent.border-radius;
                                        background: #14110fa0;
                                    }
                                }

                                if root.reorder-from >= 0 && is-page && root.reorder-to == row.index && root.reorder-to > root.reorder-from: Rectangle {
                                    height: 4px;
                                    border-radius: 2px;
                                    background: Theme.act-line;
                                }

                                // Under the strip being edited: what is happening,
                                // and what can be done to it.
                                // At 1x the column is narrow: the words go on
                                // their own line above the buttons.
                                if row.active: HorizontalLayout {
                                    padding-top: 8px;
                                    padding-bottom: 8px;
                                    spacing: 8px;
                                    min-height: 50px;
                                    // At 1x it wraps beside the buttons, so Add stays
                                    // on the caption's row.
                                    Text {
                                        text: root.problem != "" && root.connected ? root.problem : root.caption;
                                        font-family: Theme.font;
                                        font-size: Theme.size-label;
                                        color: root.problem != "" && root.connected ? Theme.crit : Theme.text-2;
                                        font-weight: root.problem != "" && root.connected ? 500 : 400;
                                        wrap: word-wrap;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        // The row is not sized to wrapped words, so the
                                        // narrow column asks for three lines.
                                        min-height: root.zoom == 1 ? 3 * 17px : 0px;
                                        accessible-role: text;
                                    }
                                    if !root.trying && row.kind != "new-takeover": HorizontalLayout {
                                        spacing: 6px;
                                        alignment: end;
                                        // Back from a widget to what holds it: the
                                        // page's name, or the takeover's triggers.
                                        if root.selected >= 0: Button {
                                            tier: "quiet";
                                            compact: root.zoom == 1;
                                            icon: row.kind == "page" ? Glyph.sliders : Glyph.cards;
                                            text: row.kind == "page" ? @tr("Page settings") : @tr("Takeover settings");
                                            label: row.kind == "page" ? @tr("Settings of the page {}", row.name) : @tr("Settings of the takeover {}: when it shows and for how long", row.name);
                                            clicked => {
                                                root.deselect();
                                            }
                                        }
                                        Button {
                                            tier: "quiet";
                                            compact: root.zoom == 1;
                                            icon: Glyph.widths;
                                            text: @tr("Equal widths");
                                            enabled: root.editable && root.zones.length > 1;
                                            label: @tr("Give every widget on {} the same width", row.name);
                                            clicked => {
                                                root.equal-widths();
                                            }
                                        }
                                        Button {
                                            tier: "primary";
                                            icon: Glyph.plus;
                                            text: root.selected >= 0 ? @tr("Add after") : @tr("Add");
                                            enabled: root.editable && root.can-add;
                                            label: root.can-add ? @tr("Add a widget to {}", row.name) : root.add-reason;
                                            clicked => {
                                                root.open-gallery();
                                                root.show-sheet("gallery");
                                            }
                                        }
                                    }
                                }
                                if row.active && !root.can-add && !root.trying && root.editable: Hint {
                                    text: root.add-reason;
                                    horizontal-alignment: right;
                                }

                                // The settings, attached to the strip.
                                if row.active && !root.trying: panel := Rectangle {
                                    property <length> most: max(220px, board.visible-height - root.strip-h - 2 * root.bezel - 34px - 50px - 32px);
                                    height: min(panel-body.preferred-height, self.most);
                                    border-radius: Theme.r-surface;
                                    background: Theme.surface;
                                    border-width: 1px;
                                    border-color: Theme.line;
                                    clip: true;
                                    panel-scroll := ScrollView {
                                        panel-body := VerticalLayout {
                                            padding: 18px;
                                            padding-top: 14px;
                                            spacing: 12px;
                                            // The title of what the settings are for.
                                            HorizontalLayout {
                                                spacing: 10px;
                                                height: 34px;
                                                if root.panel-icon != "": VerticalLayout {
                                                    alignment: center;
                                                    Rectangle {
                                                        width: 30px;
                                                        height: 30px;
                                                        border-radius: 8px;
                                                        background: Theme.surface-2;
                                                        Icon {
                                                            glyph: root.panel-icon;
                                                            fill: true;
                                                            font-size: 17px;
                                                        }
                                                    }
                                                }
                                                Text {
                                                    text: root.panel-title;
                                                    font-family: Theme.font;
                                                    font-size: Theme.size-title;
                                                    font-weight: 600;
                                                    color: Theme.text;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                    accessible-role: text;
                                                }
                                                Text {
                                                    text: root.panel-note;
                                                    font-family: Theme.font;
                                                    font-size: Theme.size-label;
                                                    color: Theme.text-3;
                                                    vertical-alignment: center;
                                                    horizontal-stretch: 1;
                                                    overflow: elide;
                                                }
                                                if root.panel-kind == "widget": Button {
                                                    tier: "quiet";
                                                    destructive: true;
                                                    icon: Glyph.trash;
                                                    text: @tr("Remove");
                                                    label: @tr("Remove {} from the page (undo brings it back)", root.panel-title);
                                                    enabled: root.editable;
                                                    clicked => {
                                                        root.delete-widget();
                                                    }
                                                }
                                                if root.panel-kind == "page": Button {
                                                    tier: "quiet";
                                                    destructive: true;
                                                    icon: Glyph.trash;
                                                    text: @tr("Delete page");
                                                    enabled: root.editable && root.page-count > 1;
                                                    label: @tr("Delete the page {} (undo brings it back)", root.panel-title);
                                                    clicked => {
                                                        root.delete-page();
                                                    }
                                                }
                                                if root.panel-kind == "takeover" || root.panel-kind == "new-takeover": Button {
                                                    tier: "quiet";
                                                    destructive: root.panel-kind == "takeover";
                                                    icon: root.panel-kind == "takeover" ? Glyph.trash : Glyph.close;
                                                    text: root.panel-kind == "takeover" ? @tr("Delete takeover") : @tr("Cancel");
                                                    enabled: root.connected;
                                                    clicked => {
                                                        root.delete-takeover();
                                                    }
                                                }
                                            }
                                            // The page's own setting: its name.
                                            if root.panel-kind == "page": HorizontalLayout {
                                                spacing: 16px;
                                                Text {
                                                    text: @tr("Name");
                                                    width: Grid.label;
                                                    y: 9px;
                                                    vertical-alignment: top;
                                                    font-family: Theme.font;
                                                    font-weight: 500;
                                                    color: Theme.text-2;
                                                    accessible-role: none;
                                                }
                                                VerticalLayout {
                                                    spacing: 4px;
                                                    max-width: Grid.control-max;
                                                    for item in [{ name: root.page-name, epoch: root.resets }]: TextField {
                                                        text: item.name;
                                                        committed-value: item.name;
                                                        label: @tr("Page name");
                                                        enabled: root.editable;
                                                        accepted(text) => {
                                                            root.rename-page(text);
                                                        }
                                                        committed(text) => {
                                                            root.rename-page(text);
                                                        }
                                                    }
                                                    Hint {
                                                        text: @tr("Click a widget on the strip above to change it, or Add to put a new one on this page.");
                                                    }
                                                }
                                            }
                                            for field in root.fields: FieldRow {
                                                field: field;
                                                enabled: root.editable || root.panel-kind == "new-takeover";
                                                picks: root.picks;
                                                triggers: root.triggers;
                                                changed(key, value) => {
                                                    root.field-changed(key, value);
                                                }
                                                chose(key, index) => {
                                                    root.field-chosen(key, index);
                                                }
                                                open-picker(key) => {
                                                    root.open-picker(key);
                                                }
                                                picker-filter(text) => {
                                                    root.picker-filter(text);
                                                }
                                                picked(key, id) => {
                                                    root.picked(key, id);
                                                }
                                                remove-trigger(id) => {
                                                    root.remove-trigger(id);
                                                }
                                            }
                                            if root.draft-hint != "": HorizontalLayout {
                                                padding-left: Grid.label + 16px;
                                                Text {
                                                    text: root.draft-hint;
                                                    font-family: Theme.font;
                                                    font-size: Theme.size-label;
                                                    color: Theme.text-2;
                                                    wrap: word-wrap;
                                                    accessible-role: text;
                                                }
                                            }
                                            if root.panel-kind == "new-takeover": HorizontalLayout {
                                                padding-left: Grid.label + 16px;
                                                alignment: start;
                                                Button {
                                                    tier: "primary";
                                                    icon: Glyph.plus;
                                                    text: @tr("Add takeover");
                                                    enabled: root.connected && root.draft-hint == "";
                                                    label: root.draft-hint == "" ? @tr("Add this takeover") : root.draft-hint;
                                                    clicked => {
                                                        root.create-takeover();
                                                    }
                                                }
                                            }
                                            // The keyboard, shown where it is used.
                                            if root.panel-kind != "new-takeover": HorizontalLayout {
                                                padding-top: 6px;
                                                spacing: 16px;
                                                Icon {
                                                    glyph: Glyph.keyboard;
                                                    color: Theme.text-3;
                                                }
                                                Shortcut {
                                                    keys: ["←", "→"];
                                                    does: @tr("select");
                                                }
                                                Shortcut {
                                                    keys: ["Ctrl", "← →"];
                                                    does: @tr("move");
                                                }
                                                Shortcut {
                                                    keys: ["Shift", "← →"];
                                                    does: @tr("resize");
                                                }
                                                Shortcut {
                                                    keys: ["Delete"];
                                                    does: @tr("remove");
                                                }
                                                Shortcut {
                                                    keys: ["Ctrl", "Z"];
                                                    does: @tr("undo");
                                                }
                                                Rectangle {
                                                    horizontal-stretch: 1;
                                                }
                                            }
                                        }
                                    }
                                }
                                if row.last-page: HorizontalLayout {
                                    padding-top: 12px;
                                    alignment: start;
                                    Button {
                                        tier: "default";
                                        icon: Glyph.plus;
                                        text: @tr("Add page");
                                        enabled: root.connected && !root.trying;
                                        clicked => {
                                            root.add-page();
                                        }
                                    }
                                }
                                Rectangle {
                                    height: 10px;
                                }
                            }

                            // Takeovers: the heading when there are none yet, and
                            // the way to add one.
                            if root.takeover-count == 0: VerticalLayout {
                                padding-top: 28px;
                                padding-bottom: 8px;
                                spacing: 2px;
                                Heading {
                                    text: @tr("Takeovers");
                                }
                                Hint {
                                    text: @tr("A takeover covers the page for a few seconds when a reading changes: the track, the volume. None yet.");
                                }
                            }
                            HorizontalLayout {
                                padding-top: 4px;
                                alignment: start;
                                Button {
                                    icon: Glyph.plus;
                                    text: @tr("Add takeover");
                                    enabled: root.connected && !root.trying;
                                    clicked => {
                                        root.add-takeover();
                                    }
                                }
                            }

                            // For tinkerers: every reading, live.
                            VerticalLayout {
                                padding-top: 36px;
                                spacing: 8px;
                                drawer-head := Rectangle {
                                    height: 36px;
                                    border-radius: Theme.r-control;
                                    background: drawer-touch.has-hover ? Theme.surface-2 : transparent;
                                    property <bool> open: false;
                                    accessible-role: button;
                                    accessible-label: self.open ? @tr("Signals, expanded") : @tr("Signals, collapsed");
                                    accessible-expandable: true;
                                    accessible-expanded: self.open;
                                    accessible-action-default => {
                                        self.open = !self.open;
                                    }
                                    HorizontalLayout {
                                        padding-left: 6px;
                                        spacing: 8px;
                                        Icon {
                                            glyph: drawer-head.open ? Glyph.caret-down : Glyph.caret-right;
                                            font-size: 14px;
                                        }
                                        Text {
                                            text: @tr("Signals");
                                            font-family: Theme.font;
                                            font-weight: 600;
                                            color: Theme.text-2;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: !root.connected ? @tr("not live while disconnected")
                                                : @tr("every reading the strip can show ({})", root.signal-rows.length);
                                            font-family: Theme.font;
                                            font-size: Theme.size-label;
                                            color: Theme.text-3;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                        }
                                    }
                                    drawer-touch := TouchArea {
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => {
                                            drawer-focus.focus();
                                            drawer-head.open = !drawer-head.open;
                                        }
                                    }
                                    drawer-focus := FocusScope {
                                        // Its ring is for focus reached by the keyboard; a click
                                        // focuses it too, and shows the press instead.
                                        property <bool> by-keys;
                                        focus-gained(reason) => {
                                            self.by-keys = reason == FocusReason.tab-navigation;
                                        }
                                        // Its TouchArea focuses it; taking the press here would
                                        // swallow the first click.
                                        focus-on-click: false;
                                        key-pressed(event) => {
                                            if event.text == " " || event.text == Key.Return {
                                                drawer-head.open = !drawer-head.open;
                                                return accept;
                                            }
                                            reject
                                        }
                                    }
                                    FocusRing {
                                        width: parent.width + 8px;
                                        height: parent.height + 8px;
                                        shown: drawer-focus.has-focus && drawer-focus.by-keys;
                                    }
                                }
                                if drawer-head.open: Rectangle {
                                    border-radius: Theme.r-surface;
                                    background: Theme.surface;
                                    border-width: 1px;
                                    border-color: Theme.line;
                                    VerticalLayout {
                                        padding: 8px;
                                        for s in root.signal-rows: HorizontalLayout {
                                            height: 30px;
                                            spacing: 10px;
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            accessible-role: list-item;
                                            accessible-label: s.name + ", " + s.value + ". " + s.id;
                                            Icon {
                                                glyph: s.icon;
                                                fill: true;
                                                width: 18px;
                                            }
                                            Text {
                                                text: s.name;
                                                font-family: Theme.font;
                                                font-size: Theme.size-label;
                                                color: Theme.text;
                                                vertical-alignment: center;
                                                width: 200px;
                                                overflow: elide;
                                            }
                                            // The raw name, for a layout file or a script.
                                            Text {
                                                text: s.id;
                                                font-family: Theme.font;
                                                font-size: Theme.size-small;
                                                color: Theme.text-3;
                                                vertical-alignment: center;
                                                horizontal-stretch: 1;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: root.connected ? s.value : "—";
                                                font-family: Theme.font;
                                                font-size: Theme.size-label;
                                                color: Theme.text-2;
                                                vertical-alignment: center;
                                                horizontal-alignment: right;
                                                overflow: elide;
                                                max-width: 200px;
                                            }
                                        }
                                        if root.signal-rows.length == 0: Hint {
                                            text: @tr("No readings yet.");
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ---- Menus ----------------------------------------------------------

    layout-menu := PopupWindow {
        // Closed by its rows: the default policy would also close it on
        // the release of the click that opened it.
        close-policy: PopupClosePolicy.close-on-click-outside;
        x: layout-button.absolute-position.x - root.absolute-position.x;
        y: header.height - 6px;
        width: 300px;
        Rectangle {
            background: Theme.surface;
            border-radius: Theme.r-surface;
            border-width: 1px;
            border-color: Theme.line-strong;
            drop-shadow-blur: 20px;
            drop-shadow-color: #00000060;
            VerticalLayout {
                padding: 6px;
                Text {
                    text: @tr("Layouts");
                    font-family: Theme.font;
                    font-size: Theme.size-small;
                    font-weight: 600;
                    color: Theme.text-3;
                    height: 26px;
                    vertical-alignment: center;
                    x: 10px;
                }
                for l[i] in root.layouts: HorizontalLayout {
                    MenuRow {
                        text: l.name;
                        checked: l.active;
                        note: l.active ? @tr("on the strip") : "";
                        clicked => {
                            root.use-layout(i);
                            // Last: closing drops the menu, and what is in it.
                            layout-menu.close();
                        }
                    }
                    if !l.active: IconButton {
                        icon: Glyph.trash;
                        label: @tr("Delete layout {} (undo brings it back)", l.name);
                        clicked => {
                            root.delete-layout(i);
                            // Last: closing drops the menu, and what is in it.
                            layout-menu.close();
                        }
                    }
                }
                MenuDivider { }
                MenuRow {
                    icon: Glyph.plus;
                    text: @tr("New layout…");
                    clicked => {
                        root.open-starters();
                        root.show-sheet("starters");
                        // Last: closing drops the menu, and what is in it.
                        layout-menu.close();
                    }
                }
                MenuRow {
                    icon: Glyph.copy;
                    text: @tr("Duplicate");
                    clicked => {
                        root.duplicate-layout();
                        // Last: closing drops the menu, and what is in it.
                        layout-menu.close();
                    }
                }
                MenuRow {
                    icon: Glyph.pencil;
                    text: @tr("Rename…");
                    clicked => {
                        root.show-sheet("rename");
                        // Last: closing drops the menu, and what is in it.
                        layout-menu.close();
                    }
                }
                MenuDivider { }
                MenuRow {
                    icon: Glyph.import;
                    text: @tr("Import from a file…");
                    clicked => {
                        root.import-layout();
                        // Last: closing drops the menu, and what is in it.
                        layout-menu.close();
                    }
                }
                MenuRow {
                    icon: Glyph.export;
                    text: @tr("Export to a file…");
                    clicked => {
                        root.export-layout();
                        // Last: closing drops the menu, and what is in it.
                        layout-menu.close();
                    }
                }
            }
        }
    }

    more-menu := PopupWindow {
        // Closed by its rows: the default policy would also close it on
        // the release of the click that opened it.
        close-policy: PopupClosePolicy.close-on-click-outside;
        x: root.width - 250px;
        y: header.height - 6px;
        width: 240px;
        Rectangle {
            background: Theme.surface;
            border-radius: Theme.r-surface;
            border-width: 1px;
            border-color: Theme.line-strong;
            drop-shadow-blur: 20px;
            drop-shadow-color: #00000060;
            VerticalLayout {
                padding: 6px;
                MenuRow {
                    icon: Glyph.gear;
                    text: @tr("Preferences…");
                    enabled: root.connected;
                    clicked => {
                        root.show-sheet("prefs");
                        // Last: closing drops the menu, and what is in it.
                        more-menu.close();
                    }
                }
                MenuRow {
                    icon: Glyph.copy;
                    text: root.copied ? @tr("Copied") : @tr("Copy diagnostics");
                    enabled: root.diagnostics != "";
                    clicked => {
                        root.copy-diagnostics();
                        // Last: closing drops the menu, and what is in it.
                        more-menu.close();
                    }
                }
                MenuDivider { }
                // At the window's top level and never disabled: Slint's
                // royalty-free licence asks for its AboutSlint widget in an
                // About screen reached from there.
                MenuRow {
                    icon: Glyph.info;
                    text: @tr("About Nexus Open");
                    clicked => {
                        root.show-sheet("about");
                        // Last: closing drops the menu, and what is in it.
                        more-menu.close();
                    }
                }
            }
        }
    }

    status-menu := PopupWindow {
        x: max(8px, status-chip.absolute-position.x - root.absolute-position.x + status-chip.width - self.width);
        y: header.height - 6px;
        width: 440px;
        close-policy: PopupClosePolicy.close-on-click-outside;
        Rectangle {
            background: Theme.surface;
            border-radius: Theme.r-surface;
            border-width: 1px;
            border-color: Theme.line-strong;
            drop-shadow-blur: 20px;
            drop-shadow-color: #00000060;
            VerticalLayout {
                padding: 18px;
                spacing: 10px;
                Text {
                    text: root.status.headline;
                    font-family: Theme.font;
                    font-size: Theme.size-title;
                    font-weight: 600;
                    color: Theme.text;
                    wrap: word-wrap;
                    accessible-role: text;
                }
                Text {
                    text: root.status.body;
                    font-family: Theme.font;
                    color: Theme.text-2;
                    wrap: word-wrap;
                    accessible-role: text;
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    if root.status.start: Button {
                        tier: "primary";
                        icon: Glyph.power;
                        text: @tr("Start the service");
                        clicked => {
                            root.start-service();
                        }
                    }
                    if root.status.retry: Button {
                        tier: root.status.start ? "default" : "primary";
                        icon: Glyph.retry;
                        text: @tr("Try again");
                        clicked => {
                            root.check-again();
                        }
                    }
                    if root.status.log: Button {
                        icon: Glyph.log;
                        text: @tr("Open the log");
                        clicked => {
                            root.open-log();
                            root.show-sheet("log");
                            // Last: closing first would end this handler.
                            status-menu.close();
                        }
                    }
                }
                HorizontalLayout {
                    alignment: start;
                    Button {
                        tier: "quiet";
                        compact: true;
                        icon: Glyph.copy;
                        text: root.copied ? @tr("Copied") : @tr("Copy diagnostics");
                        enabled: root.diagnostics != "";
                        clicked => {
                            root.copy-diagnostics();
                        }
                    }
                }
                if root.status.detail != "": VerticalLayout {
                    spacing: 4px;
                    Hint {
                        text: @tr("For those who use a terminal:");
                    }
                    Rectangle {
                        border-radius: 8px;
                        background: Theme.surface-2;
                        // Sized by its words, so a long command wraps
                        // inside rather than running out of the box.
                        VerticalLayout {
                            padding: 8px;
                            padding-left: 10px;
                            padding-right: 10px;
                            TextInput {
                                text: root.status.detail;
                                read-only: true;
                                single-line: false;
                                wrap: word-wrap;
                                font-family: "monospace";
                                font-size: 12px;
                                color: Theme.text-2;
                                accessible-label: @tr("The fix as commands");
                            }
                        }
                    }
                }
            }
        }
    }

    // ---- Sheets ---------------------------------------------------------

    if root.sheet == "gallery": Sheet {
        title: @tr("Add to the strip");
        subtitle: root.gallery-note;
        // As many whole columns of tiles as fit, up to three, and the
        // sheet exactly as wide as they are.
        property <length> tile-w: 240 * root.unit + 32px;
        property <int> cols: max(1, min(3, floor((root.width - 64px - 64px + 12px) / (tile-w + 12px))));
        sheet-width: cols * (tile-w + 12px) - 12px + 48px + 16px;
        close => {
            root.sheet = "";
        }
        for g[gi] in root.groups: VerticalLayout {
            padding-bottom: 16px;
            spacing: 10px;
            Text {
                text: g;
                font-family: Theme.font;
                font-size: Theme.size-title;
                font-weight: 600;
                color: Theme.text;
                accessible-role: text;
            }
            Rectangle {
                property <int> cols: max(1, floor((self.width + 12px) / (tile-w + 12px)));
                height: ceil(root.group-sizes[gi] / self.cols) * (48 * root.unit + 96px) - 12px;
                for t[ti] in root.tiles: Rectangle {
                    visible: t.group == gi;
                    x: mod(t.slot, parent.cols) * (tile-w + 12px);
                    y: floor(t.slot / parent.cols) * (48 * root.unit + 96px);
                    width: tile-w;
                    height: 48 * root.unit + 84px;
                    border-radius: Theme.r-surface;
                    background: tile-touch.has-hover && root.can-add ? Theme.surface-2 : Theme.surface;
                    border-width: 1px;
                    border-color: Theme.line;
                    opacity: root.can-add ? 1 : 0.5;
                    FocusRing {
                        width: parent.width + 8px;
                        height: parent.height + 8px;
                        radius: Theme.r-surface;
                        shown: tile-focus.has-focus && tile-focus.by-keys;
                    }
                    accessible-role: button;
                    accessible-label: @tr("{}: {}", t.name, t.about);
                    accessible-enabled: root.can-add;
                    accessible-action-default => {
                        if root.can-add {
                            root.add-tile(ti);
                            root.sheet = "";
                        }
                    }
                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;
                        // The widget in a bezel its own width, as wide
                        // as it would be on the strip.
                        HorizontalLayout {
                            alignment: start;
                            Rectangle {
                            width: t.width * root.unit + 8px;
                            height: 48 * root.unit + 8px;
                            border-radius: 8px;
                            background: Theme.bezel;
                            Image {
                                x: 4px;
                                y: 4px;
                                width: t.width * root.unit;
                                height: 48 * root.unit;
                                source: t.image;
                                image-rendering: pixelated;
                            }
                            }
                        }
                        Text {
                            text: t.name;
                            font-family: Theme.font;
                            font-weight: 600;
                            color: Theme.text;
                        }
                        Text {
                            text: t.about;
                            font-family: Theme.font;
                            font-size: Theme.size-label;
                            color: Theme.text-3;
                            overflow: elide;
                        }
                    }
                    tile-touch := TouchArea {
                        enabled: root.can-add;
                        mouse-cursor: MouseCursor.pointer;
                        clicked => {
                            root.add-tile(ti);
                            root.sheet = "";
                        }
                    }
                    tile-focus := FocusScope {
                        // Its ring is for focus reached by the keyboard; a click
                        // focuses it too, and shows the press instead.
                        property <bool> by-keys;
                        focus-gained(reason) => {
                            self.by-keys = reason == FocusReason.tab-navigation;
                        }
                        // Its TouchArea focuses it; taking the press here would
                        // swallow the first click.
                        focus-on-click: false;
                        enabled: t.group == gi && root.can-add;
                        key-pressed(event) => {
                            if event.text == " " || event.text == Key.Return {
                                root.add-tile(ti);
                                root.sheet = "";
                                return accept;
                            }
                            reject
                        }
                    }
                }
            }
        }
    }

    if root.sheet == "starters": Sheet {
        title: root.first-run ? @tr("Welcome. How should your strip start?") : @tr("New layout");
        subtitle: root.first-run
            ? @tr("Pick one to put it on the strip now. Everything in it can be changed afterwards, and undo takes it back.")
            : @tr("It goes on the strip at once. Undo takes it back.");
        // Previews at exactly 1x: the sheet is a chooser, not the editor.
        sheet-width: 640px + 8px + 28px + 48px + 16px;
        close => {
            if root.first-run {
                root.dismiss-first-run();
            }
            root.sheet = "";
        }
        VerticalLayout {
            spacing: 12px;
            for s[i] in root.starters: Rectangle {
                height: 48px + 82px;
                border-radius: Theme.r-surface;
                background: st-touch.has-hover ? Theme.surface-2 : Theme.surface;
                border-width: 1px;
                border-color: Theme.line;
                accessible-role: button;
                accessible-label: @tr("{}: {}", s.name, s.about);
                FocusRing {
                    width: parent.width + 8px;
                    height: parent.height + 8px;
                    radius: Theme.r-surface;
                    shown: st-focus.has-focus && st-focus.by-keys;
                }
                accessible-action-default => {
                    root.choose-starter(i);
                    root.sheet = "";
                }
                VerticalLayout {
                    padding: 14px;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 10px;
                        Text {
                            text: s.name;
                            font-family: Theme.font;
                            font-weight: 600;
                            font-size: Theme.size-title;
                            color: Theme.text;
                        }
                        Text {
                            text: s.about;
                            font-family: Theme.font;
                            font-size: Theme.size-label;
                            color: Theme.text-3;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }
                    Rectangle {
                        height: 48px + 8px;
                        width: 640px + 8px;
                        border-radius: 8px;
                        background: Theme.bezel;
                        Image {
                            x: 4px;
                            y: 4px;
                            width: 640px;
                            height: 48px;
                            source: s.image;
                            image-rendering: pixelated;
                        }
                    }
                }
                st-touch := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => {
                        root.choose-starter(i);
                        root.sheet = "";
                    }
                }
                st-focus := FocusScope {
                    // Its ring is for focus reached by the keyboard; a click
                    // focuses it too, and shows the press instead.
                    property <bool> by-keys;
                    focus-gained(reason) => {
                        self.by-keys = reason == FocusReason.tab-navigation;
                    }
                    // Its TouchArea focuses it; taking the press here would
                    // swallow the first click.
                    focus-on-click: false;
                    key-pressed(event) => {
                        if event.text == " " || event.text == Key.Return {
                            root.choose-starter(i);
                            root.sheet = "";
                            return accept;
                        }
                        reject
                    }
                }
            }
            if root.first-run: HorizontalLayout {
                alignment: end;
                Button {
                    tier: "quiet";
                    text: @tr("Keep the one on the strip");
                    clicked => {
                        root.dismiss-first-run();
                        root.sheet = "";
                    }
                }
            }
        }
    }

    if root.sheet == "rename": Sheet {
        title: @tr("Rename the layout");
        sheet-width: 460px;
        close => {
            root.sheet = "";
        }
        VerticalLayout {
            spacing: 14px;
            name-field := TextField {
                text: root.layout-name;
                label: @tr("Layout name");
                init => {
                    self.focus-input();
                    self.select-all();
                }
                accepted(text) => {
                    root.rename-layout(text);
                    root.sheet = "";
                }
            }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                Button {
                    tier: "quiet";
                    text: @tr("Cancel");
                    clicked => {
                        root.sheet = "";
                    }
                }
                Button {
                    tier: "primary";
                    text: @tr("Rename");
                    clicked => {
                        root.rename-layout(name-field.text);
                        root.sheet = "";
                    }
                }
            }
        }
    }

    if root.sheet == "prefs": Sheet {
        title: @tr("Preferences");
        subtitle: @tr("The strip settings are for every layout: they show at once, and undo takes them back.");
        sheet-width: 680px;
        close => {
            root.sheet = "";
        }
        VerticalLayout {
            spacing: 18px;
            HorizontalLayout {
                spacing: 16px;
                Label {
                    text: @tr("Temperatures");
                    width: Grid.label;
                    color: Theme.text-2;
                    font-weight: 500;
                }
                HorizontalLayout {
                    alignment: start;
                    Segmented {
                        options: ["°C", "°F"];
                        current: root.pref-temperature;
                        label: @tr("Temperatures in");
                        chose(i) => {
                            root.set-pref("temperature", i == 1 ? "f" : "c");
                        }
                    }
                }
            }
            HorizontalLayout {
                spacing: 16px;
                Label {
                    text: @tr("Clock");
                    width: Grid.label;
                    color: Theme.text-2;
                    font-weight: 500;
                }
                HorizontalLayout {
                    alignment: start;
                    Segmented {
                        options: [@tr("24-hour"), @tr("12-hour")];
                        current: root.pref-clock;
                        label: @tr("Clock");
                        chose(i) => {
                            root.set-pref("clock", i == 1 ? "12" : "24");
                        }
                    }
                }
            }
            HorizontalLayout {
                spacing: 16px;
                Label {
                    text: @tr("Accent");
                    width: Grid.label;
                    y: 6px;
                    vertical-alignment: top;
                    color: Theme.text-2;
                    font-weight: 500;
                }
                VerticalLayout {
                    spacing: 10px;
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        for c[i] in root.accent-swatches: Rectangle {
                            width: 34px;
                            height: 34px;
                            border-radius: 17px;
                            background: c;
                            border-width: i == root.accent-current ? 3px : 0px;
                            border-color: Theme.text;
                            accessible-role: button;
                            accessible-label: root.accent-names[i];
                            accessible-item-selectable: true;
                            accessible-item-selected: i == root.accent-current;
                            accessible-action-default => {
                                root.set-pref("accent-preset", i);
                            }
                            if i == root.accent-current: Icon {
                                glyph: Glyph.check;
                                color: #14110f;
                            }
                            sw-touch := TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                clicked => {
                                    sw-focus.focus();
                                    root.set-pref("accent-preset", i);
                                }
                            }
                            sw-focus := FocusScope {
                                // Its ring is for focus reached by the keyboard; a click
                                // focuses it too, and shows the press instead.
                                property <bool> by-keys;
                                focus-gained(reason) => {
                                    self.by-keys = reason == FocusReason.tab-navigation;
                                }
                                // Its TouchArea focuses it; taking the press here would
                                // swallow the first click.
                                focus-on-click: false;
                                key-pressed(event) => {
                                    if event.text == " " || event.text == Key.Return {
                                        root.set-pref("accent-preset", i);
                                        return accept;
                                    }
                                    reject
                                }
                            }
                            FocusRing {
                                width: parent.width + 8px;
                                height: parent.height + 8px;
                                shown: sw-focus.has-focus && sw-focus.by-keys;
                                radius: 17px;
                            }
                            // Its name, as a tooltip: above, where nothing
                            // drawn later covers it.
                            if sw-touch.has-hover || (sw-focus.has-focus && sw-focus.by-keys): Rectangle {
                                y: -30px;
                                x: (parent.width - self.width) / 2;
                                width: sw-name.preferred-width + 16px;
                                height: 24px;
                                border-radius: 6px;
                                background: Theme.text;
                                sw-name := Text {
                                    text: root.accent-names[i];
                                    font-family: Theme.font;
                                    font-size: Theme.size-small;
                                    font-weight: 500;
                                    color: Theme.surface;
                                    accessible-role: none;
                                }
                            }
                        }
                        for item in [{ v: root.pref-accent, epoch: root.resets }]: TextField {
                            width: 130px;
                            text: item.v;
                            committed-value: item.v;
                            placeholder: "#b6a2ff";
                            label: @tr("Your own colour, written #rrggbb");
                            accepted(text) => {
                                root.set-pref("accent", text);
                            }
                            committed(text) => {
                                root.set-pref("accent", text);
                            }
                        }
                    }
                    // What the accent marks, as the strip draws it: things a
                    // finger can act on, never readings or warnings.
                    Rectangle {
                        height: 92px;
                        border-radius: Theme.r-surface;
                        background: #14110f;
                        HorizontalLayout {
                            padding: 12px;
                            spacing: 18px;
                            VerticalLayout {
                                spacing: 6px;
                                alignment: center;
                                Rectangle {
                                    width: 44px;
                                    height: 33px;
                                    border-radius: 9px;
                                    background: Theme.accent-base;
                                    Icon {
                                        glyph: "\u{e3d0}";
                                        fill: true;
                                        color: Theme.accent-ink;
                                        font-size: 20px;
                                    }
                                }
                                Text {
                                    text: @tr("Main key");
                                    font-family: Theme.font;
                                    font-size: 11px;
                                    color: #9c8c7c;
                                    horizontal-alignment: center;
                                }
                            }
                            VerticalLayout {
                                spacing: 6px;
                                alignment: center;
                                Rectangle {
                                    width: 44px;
                                    height: 33px;
                                    border-radius: 9px;
                                    background: #4a3e35;
                                    Rectangle {
                                        y: 0;
                                        height: 1px;
                                        width: parent.width - 16px;
                                        background: #65564a;
                                    }
                                    Icon {
                                        glyph: "\u{e28e}";
                                        color: Theme.accent-text;
                                        font-size: 20px;
                                    }
                                }
                                Text {
                                    text: @tr("Key");
                                    font-family: Theme.font;
                                    font-size: 11px;
                                    color: #9c8c7c;
                                    horizontal-alignment: center;
                                }
                            }
                            VerticalLayout {
                                spacing: 6px;
                                alignment: center;
                                horizontal-stretch: 1;
                                Rectangle {
                                    height: 33px;
                                    Rectangle {
                                        y: 14px;
                                        height: 5px;
                                        border-radius: 2.5px;
                                        background: #3d342d;
                                    }
                                    Rectangle {
                                        x: 0;
                                        y: 14px;
                                        width: parent.width * 0.6;
                                        height: 5px;
                                        border-radius: 2.5px;
                                        background: Theme.accent-fill;
                                    }
                                    Rectangle {
                                        x: parent.width * 0.6 - 8px;
                                        y: 8.5px;
                                        width: 16px;
                                        height: 16px;
                                        border-radius: 8px;
                                        background: #e6d6c0;
                                        border-width: 2px;
                                        border-color: Theme.accent-base;
                                    }
                                }
                                Text {
                                    text: @tr("Slider");
                                    font-family: Theme.font;
                                    font-size: 11px;
                                    color: #9c8c7c;
                                    horizontal-alignment: center;
                                }
                            }
                            VerticalLayout {
                                spacing: 6px;
                                alignment: center;
                                Rectangle {
                                    width: 96px;
                                    height: 33px;
                                    border-radius: 9px;
                                    border-width: 1.5px;
                                    border-color: Theme.accent-base;
                                    Text {
                                        text: @tr("Set up");
                                        font-family: Theme.font;
                                        font-weight: 600;
                                        color: Theme.accent-text;
                                    }
                                }
                                Text {
                                    text: @tr("Not set up");
                                    font-family: Theme.font;
                                    font-size: 11px;
                                    color: #9c8c7c;
                                    horizontal-alignment: center;
                                }
                            }
                            VerticalLayout {
                                spacing: 6px;
                                alignment: center;
                                Rectangle {
                                    width: 60px;
                                    height: 33px;
                                    border-radius: 9px;
                                    background: #241e1a;
                                    Text {
                                        text: "52°";
                                        font-family: Theme.font;
                                        font-weight: 600;
                                        font-size: 18px;
                                        color: #fbf1e3;
                                    }
                                }
                                Text {
                                    text: @tr("Readings stay cream");
                                    font-family: Theme.font;
                                    font-size: 11px;
                                    color: #9c8c7c;
                                    horizontal-alignment: center;
                                }
                            }
                        }
                    }
                    Hint {
                        text: root.accent-note != "" ? root.accent-note
                            : @tr("The accent marks what a finger can act on: keys, sliders, things to set up. Readings and warnings never take it.");
                    }
                }
            }
            HorizontalLayout {
                spacing: 16px;
                Label {
                    text: @tr("Weather for");
                    width: Grid.label;
                    y: 8px;
                    vertical-alignment: top;
                    color: Theme.text-2;
                    font-weight: 500;
                }
                VerticalLayout {
                    spacing: 4px;
                    for item in [{ v: root.pref-weather, epoch: root.resets }]: TextField {
                        text: item.v;
                        committed-value: item.v;
                        placeholder: @tr("Your town, as in: Lyon, France");
                        label: @tr("Weather for");
                        accepted(text) => {
                            root.set-pref("weather", text);
                        }
                        committed(text) => {
                            root.set-pref("weather", text);
                        }
                    }
                    Hint {
                        text: @tr("A town, or latitude and longitude. Empty: no weather. Looked up with Open-Meteo; it is never put in an exported layout.");
                    }
                }
            }
            HorizontalLayout {
                spacing: 16px;
                Label {
                    text: @tr("Strip lettering");
                    width: Grid.label;
                    y: 8px;
                    vertical-alignment: top;
                    color: Theme.text-2;
                    font-weight: 500;
                }
                VerticalLayout {
                    spacing: 4px;
                    Select {
                        options: root.fonts;
                        current: root.pref-font;
                        label: @tr("Strip lettering");
                        chose(i) => {
                            root.set-pref("font", i);
                        }
                    }
                    Hint {
                        text: @tr("The typeface of words and numbers on the strip.");
                    }
                }
            }
            HorizontalLayout {
                spacing: 16px;
                Label {
                    text: @tr("Dim when idle");
                    width: Grid.label;
                    y: 8px;
                    vertical-alignment: top;
                    color: Theme.text-2;
                    font-weight: 500;
                }
                VerticalLayout {
                    spacing: 4px;
                    HorizontalLayout {
                        alignment: start;
                        Segmented {
                            options: [@tr("On"), @tr("Off")];
                            current: root.pref-idle-dim ? 0 : 1;
                            label: @tr("Dim when idle");
                            chose(i) => {
                                root.set-pref("idle-dim", i == 0 ? "on" : "off");
                            }
                        }
                    }
                    Hint {
                        text: @tr("After five minutes with no touch the strip draws darker, never smaller. A warning stays bright.");
                    }
                }
            }
            HorizontalLayout {
                spacing: 16px;
                Label {
                    text: @tr("Night hours");
                    width: Grid.label;
                    y: 8px;
                    vertical-alignment: top;
                    color: Theme.text-2;
                    font-weight: 500;
                }
                VerticalLayout {
                    spacing: 4px;
                    HorizontalLayout {
                        alignment: start;
                        spacing: 10px;
                        Segmented {
                            options: [@tr("None"), @tr("Dim at night")];
                            current: root.pref-night ? 1 : 0;
                            label: @tr("Night hours");
                            chose(i) => {
                                root.set-pref("night", i == 1 ? "on" : "off");
                            }
                        }
                        if root.pref-night: HorizontalLayout {
                            spacing: 8px;
                            Label {
                                text: @tr("from");
                                vertical-alignment: center;
                                color: Theme.text-2;
                            }
                            for item in [{ v: root.pref-night-from, epoch: root.resets }]: TextField {
                                width: 76px;
                                text: item.v;
                                committed-value: item.v;
                                placeholder: "22:30";
                                label: @tr("Night starts at, HH:MM");
                                accepted(text) => {
                                    root.set-pref("night-from", text);
                                }
                                committed(text) => {
                                    root.set-pref("night-from", text);
                                }
                            }
                            Label {
                                text: @tr("to");
                                vertical-alignment: center;
                                color: Theme.text-2;
                            }
                            for item in [{ v: root.pref-night-to, epoch: root.resets }]: TextField {
                                width: 76px;
                                text: item.v;
                                committed-value: item.v;
                                placeholder: "07:00";
                                label: @tr("Night ends at, HH:MM");
                                accepted(text) => {
                                    root.set-pref("night-to", text);
                                }
                                committed(text) => {
                                    root.set-pref("night-to", text);
                                }
                            }
                        }
                    }
                    Hint {
                        text: root.pref-night
                            ? @tr("The strip dims further between these times, across midnight when the end is earlier.")
                            : @tr("None: the strip keeps its brightness all night. Dim at night sets hours when it dims further.");
                    }
                }
            }
            // The window's own preference: kept with the window, not in
            // the layout, so it never enters undo.
            Rectangle {
                height: 1px;
                background: Theme.line;
            }
            Text {
                text: @tr("This window");
                font-family: Theme.font;
                font-size: Theme.size-title;
                font-weight: 600;
                color: Theme.text;
                accessible-role: text;
            }
            HorizontalLayout {
                spacing: 16px;
                Label {
                    text: @tr("Appearance");
                    width: Grid.label;
                    y: 8px;
                    vertical-alignment: top;
                    color: Theme.text-2;
                    font-weight: 500;
                }
                VerticalLayout {
                    spacing: 4px;
                    HorizontalLayout {
                        alignment: start;
                        Segmented {
                            options: [@tr("Match the system"), @tr("Light"), @tr("Dark")];
                            current: Theme.forced;
                            label: @tr("Appearance of this window");
                            chose(i) => {
                                root.set-appearance(i);
                            }
                        }
                    }
                    Hint {
                        text: @tr("Only this window. The strip stays dark, and undo leaves this alone.");
                    }
                }
            }
        }
    }

    if root.sheet == "log": Sheet {
        title: @tr("The service's log");
        subtitle: @tr("What nexusd wrote most recently, newest at the bottom.");
        sheet-width: 820px;
        close => {
            root.sheet = "";
        }
        VerticalLayout {
            spacing: 10px;
            Rectangle {
                border-radius: 8px;
                background: Theme.surface-2;
                min-height: 200px;
                TextInput {
                    x: 12px;
                    y: 10px;
                    width: parent.width - 24px;
                    text: root.log-text == "" ? @tr("Reading the log…") : root.log-text;
                    read-only: true;
                    single-line: false;
                    wrap: word-wrap;
                    font-family: "monospace";
                    font-size: 12px;
                    color: Theme.text-2;
                    accessible-label: @tr("The service's log");
                }
            }
        }
    }

    if root.sheet == "about": Sheet {
        title: @tr("About");
        sheet-width: 480px;
        close => {
            root.sheet = "";
        }
        VerticalLayout {
            spacing: 14px;
            HorizontalLayout {
                spacing: 16px;
                VerticalLayout {
                    alignment: center;
                    Mark {
                        size: 56px;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: @tr("Nexus Open");
                        font-family: Theme.font;
                        font-size: 26px;
                        font-weight: 600;
                        color: Theme.text;
                        accessible-role: text;
                    }
                    Text {
                        text: root.daemon-version == "" || root.daemon-version == root.version
                            ? @tr("Version {}", root.version)
                            : @tr("Version {} (service {})", root.version, root.daemon-version);
                        font-family: Theme.font;
                        color: Theme.text-3;
                    }
                }
            }
            Text {
                text: @tr("Makes the Corsair iCUE Nexus touch strip useful on Linux: the time and your machine at a glance, and your music and apps under a finger. Not made or endorsed by Corsair.");
                font-family: Theme.font;
                color: Theme.text-2;
                wrap: word-wrap;
            }
            Text {
                text: @tr("Free software under the MIT licence: {}", root.homepage);
                font-family: Theme.font;
                font-size: Theme.size-label;
                color: Theme.text-3;
                wrap: word-wrap;
            }
            Rectangle {
                height: 1px;
                background: Theme.line;
            }
            HorizontalLayout {
                spacing: 12px;
                Text {
                    text: @tr("Built with");
                    font-family: Theme.font;
                    font-size: Theme.size-label;
                    color: Theme.text-3;
                    vertical-alignment: center;
                }
                // Its own badge and two lines of small print under it.
                Rectangle {
                    width: 170px;
                    height: 96px;
                    AboutSlint { }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
            }
        }
    }
}
